<!DOCTYPE html>
<html>
  <head>
    <title>404 - not found</title>
  </head>

  <body>
    <picture>
      <source
          srcset="
              https://download.smoothcomp.com/features/misc/spotlightsdark@2x.webp 2x,
              https://download.smoothcomp.com/features/misc/spotlightsdark@2x.webp 1x
          "
          type="image/webp"
      >
      <source
          srcset="
              https://download.smoothcomp.com/features/misc/spotlightsdark@2x.jpg 2x,
              https://download.smoothcomp.com/features/misc/spotlightsdark@2x.jpg 1x
          "
          type="image/jpg"
      >
      <img
          class="sc-background-img"
          loading="lazy"
          src="https://download.smoothcomp.com/features/misc/spotlightsdark@2x.jpg"
      >
    </picture>
    <div class="background-shadow"></div>

    <div class="content">
      
      <h1>
        Humm, no - we could not<br>
        find that page 🤔
      </h1>

      <p>We tried but we couldn't find what you're looking for.</p>

      <small>Error code: 0905-x-sazom-dafir</small>

      <a href="/" class="sc-btn sc-btn-primary sc-btn-rounded">Abu Dhabi Jiu Jitsu Pro home</a>
    </div>
  </body>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@500&display=swap');
    body {
      font-family: Inter,Helvetica,Arial,sans-serif;
      font-size: large;
      -webkit-font-smoothing: antialiased;
      color: #fff;
      background: #000000;

      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0 !important;
    }

    body * {
      margin: 0;
    }

    .content {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 1vh;
    }

    .sc-logo-link {
      margin-bottom: 3vh;
    }
    svg {
      height: 7vh;
      width: 7vh;
    }
    h1 {
      margin-bottom: 2vh;
      font-size: 3.5vh;
    }
    p {
      margin-bottom: 1.5vh;
      font-size: 1.2vh;
      color: rgba(244, 246, 251, .7);
    }
    small {
      margin-bottom: 3vh;
      font-size: 1vh;
      color: rgba(244, 246, 251, .5);
    }

    .sc-background-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 85%;
      position: absolute;
      top: 0;
      left: 0;
      z-index: -1;
    }

    .background-shadow {
      background: linear-gradient(to top, rgba(0,0,0,1) 0%, rgba(0,0,0,.5) 25%, rgba(0,0,0,0) 100%);
      width: 100%;
      height: 100%;
      position: absolute;
      top: 0;
      right: 0;
      z-index: -1;
    }

    .sc-btn {
      background: rgba(244, 246, 251, .1);
      color: #f4f6fb;
      border-radius: .25rem;
      text-align: center;
      font-size: 1.5vh;
      cursor: pointer;
      transition: .1s all ease;

      display: inline-flex;
      justify-content: center;
      align-items: center;
      vertical-align: middle;
      gap: .5rem;
      max-width: 100%;
      text-decoration: none;
      padding: 1vh 1.5vh;
    }

    .sc-btn-primary {
      background: #2C3EDC;
      color: #f4f6fb;
    }
    .sc-btn-primary:hover {
      background: rgba(36, 51, 179, 1);
    }
    .sc-btn-primary:active {
      background: rgba(35, 50, 176, 1);
    }
    .sc-btn-rounded {
      border-radius: 999px;
    }
  </style>
</html>
