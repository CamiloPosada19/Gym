---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import AboutSalva from '../components/AboutSalva.astro';
import Disciplines from '../components/Disciplines.astro';
import Facility from '../components/Facility.astro';
import ScheduleFAQ from '../components/ScheduleFAQ.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout
  title="CHIDAOBA | Club de Judo Olímpico y Brazilian Jiu-Jitsu en Alicante"
  description="Club de Judo Olímpico y Brazilian Jiu-Jitsu en Alicante (C/ de Perú, 14): Salvador Cases (Olímpico París 2024), Carlos Cases y Mirco Biscarini. Consulta horarios oficiales y reserva tu clase de prueba."
>
  <!-- Top Navigation with Announcement Bar -->
  <Navbar />

  <main>
    <!-- Hero Section with Training Schedule Preview and Main Action -->
    <Hero />

    <!-- Who are the Cases Brothers (Salvador & Carlos Cases), Olympic & National pedigree, Real photos -->
    <AboutSalva />

    <!-- Disciplines: Judo Olimpico & Brazilian Jiu-Jitsu (Gi/No-Gi) with Chidaoba ethos -->
    <Disciplines />

    <!-- The Facility / Dojo Chidaoba (C/ de Perú, 14, Planta G) -->
    <Facility />

    <!-- Timetable and Frequently Asked Questions (Horarios) -->
    <ScheduleFAQ />
  </main>

  <!-- Footer with Links and Real Address -->
  <Footer />

  <!-- Floating Sticky WhatsApp Widget -->
  <WhatsAppButton />
</Layout>
