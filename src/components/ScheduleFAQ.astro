                              </span>

                              <!-- Subtle subtitle label -->
                              <span data-slot-label={slot.label} class={`slot-label-text text-[9px] truncate max-w-[95px] block ${
                                isBJJGi ? 'text-zinc-600 font-semibold' : (isJudo && isKids ? 'text-amber-300 font-semibold' : 'text-zinc-400')
                              }`}>
                                {slot.label}
                              </span>

                              <!-- Subtle hover prompt -->
                              <span class={`text-[8px] font-bold uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity ${
                                isBJJGi ? 'text-red-700' : 'text-red-400'
                              }`}>
                                <span data-i18n="schedule.hoverBook">Reservar &rarr;</span>
                              </span>
                            </a>
                          );
                        })}
                      </div>
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
