<!-- Client Script for Interactive Filters and Mobile View Switching -->
<script is:inline>
  (function () {
    // 1. Discipline Filter Logic
    const filterPills = document.querySelectorAll('.filter-pill');
    const slotCards = document.querySelectorAll('.schedule-slot-card, .schedule-card-mobile');

    filterPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const filter = pill.getAttribute('data-filter');

        // Update active state of pills
        filterPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');

        // Filter cards
        slotCards.forEach(card => {
          const slotType = (card.getAttribute('data-slot-type') || '').toLowerCase();
          const slotName = (card.getAttribute('data-slot-name') || '').toUpperCase();
          const slotLabel = (card.getAttribute('data-filter-label') || card.getAttribute('data-slot-label') || '').toLowerCase();
          const types = slotType.split(/\s+/);

          let isMatch = false;
          if (filter === 'all') {
            isMatch = true;
          } else if (filter === 'judo') {
            isMatch = types.includes('judo') || slotName.includes('JUDO');
          } else if (filter === 'kids') {
            isMatch = types.includes('kids') || slotLabel.includes('kids') || slotLabel.includes('años');
          } else if (filter === 'bjj-gi') {
            isMatch = types.includes('bjj-gi');
          } else if (filter === 'nogi') {
            isMatch = types.includes('nogi') || slotName.includes('NOGI');
          } else if (filter === 'femenino') {
            isMatch = types.includes('femenino') || slotLabel.includes('femenino');
          } else if (filter === 'tatami') {
            isMatch = types.includes('tatami');
          } else {
            isMatch = types.includes(filter);
          }

          if (isMatch) {
            card.style.opacity = '1';
            card.style.filter = 'grayscale(0%)';
            card.style.transform = 'scale(1)';
          } else {
            card.style.opacity = '0.25';
            card.style.filter = 'grayscale(80%)';
            card.style.transform = 'scale(0.96)';
          }
        });
      });
    });

    // 2. Mobile View Toggle (Day View vs Table View)
    const btnViewDay = document.getElementById('btn-view-day');
    const btnViewTable = document.getElementById('btn-view-table');
    const mobileDayView = document.getElementById('mobile-day-view');
    const fullTableView = document.getElementById('full-table-view');

    if (btnViewDay && btnViewTable && mobileDayView && fullTableView) {
      btnViewDay.addEventListener('click', () => {
        btnViewDay.classList.add('bg-red-600', 'text-white', 'shadow-md');
        btnViewDay.classList.remove('text-zinc-600', 'dark:text-zinc-400');
        btnViewTable.classList.remove('bg-red-600', 'text-white', 'shadow-md');
        btnViewTable.classList.add('text-zinc-600', 'dark:text-zinc-400');

        mobileDayView.classList.remove('hidden');
        fullTableView.classList.add('hidden');
      });

      btnViewTable.addEventListener('click', () => {
        btnViewTable.classList.add('bg-red-600', 'text-white', 'shadow-md');
        btnViewTable.classList.remove('text-zinc-600', 'dark:text-zinc-400');
        btnViewDay.classList.remove('bg-red-600', 'text-white', 'shadow-md');
        btnViewDay.classList.add('text-zinc-600', 'dark:text-zinc-400');

        fullTableView.classList.remove('hidden');
        fullTableView.classList.remove('sm:block');
        mobileDayView.classList.add('hidden');
      });
    }

    // 3. Mobile Day Tab Switching
    const dayTabBtns = document.querySelectorAll('.day-tab-btn');
    const dayPanels = document.querySelectorAll('.day-panel');

    dayTabBtns.forEach(tab => {
      tab.addEventListener('click', () => {
        const dayId = tab.getAttribute('data-day-tab');

        // Update tab button styles
        dayTabBtns.forEach(t => {
          t.classList.remove('active', 'bg-zinc-900', 'text-white', 'dark:bg-white', 'dark:text-black', 'font-black', 'shadow-md');
          t.classList.add('text-zinc-600', 'dark:text-zinc-400');
        });
        tab.classList.add('active', 'bg-zinc-900', 'text-white', 'dark:bg-white', 'dark:text-black', 'font-black', 'shadow-md');
        tab.classList.remove('text-zinc-600', 'dark:text-zinc-400');

        // Show target panel
        dayPanels.forEach(p => {
          p.classList.add('hidden');
          p.classList.remove('block');
        });
        const targetPanel = document.getElementById(`day-panel-${dayId}`);
        if (targetPanel) {
          targetPanel.classList.remove('hidden');
          targetPanel.classList.add('block');
        }
      });
    });
  })();
</script>
