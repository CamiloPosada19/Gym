---
// src/components/ScheduleFAQ.astro

const whatsappNumber = "34600000000";
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const times = ["09:30", "10:00", "15:00", "17:30", "18:00", "18:30", "19:00", "19:30", "20:00"];

const daysData = [
  {
    id: "lunes",
    name: "Lunes",
    shortName: "LUN",
    slots: {
      "09:30": [{ name: "BJJ", type: "bjj-gi", label: "Todos Niveles (T1)", icon: "🥋" }],
      "17:30": [{ name: "JUDO", type: "kids", label: "Kids 3-5 (T1)", icon: "👶" }],
      "18:30": [{ name: "JUDO", type: "kids", label: "6-12 Años (T2)", icon: "🥋" }],
      "19:00": [{ name: "GRAP NOGI", type: "nogi", label: "Fundamentos (T1)", icon: "🤼" }],
      "19:30": [{ name: "JUDO", type: "judo", label: "Competición (T2)", icon: "🥋" }],
      "20:00": [{ name: "GRAP NOGI", type: "nogi", label: "Avanzados (T1)", icon: "🤼" }]
    }
  },
  {
    id: "martes",
    name: "Martes",
    shortName: "MAR",
    slots: {
      "09:30": [{ name: "BJJ", type: "tatami", label: "Open Matt (T1)", icon: "✋" }],
      "15:00": [{ name: "BJJ", type: "bjj-gi", label: "Todos Niveles (T1)", icon: "🥋" }],
      "18:00": [
        { name: "BJJ", type: "femenino", label: "Femenino (T1)", icon: "👩" },
        { name: "BJJ", type: "kids", label: "Kids 5-11 (T2)", icon: "👶" }
      ],
      "19:00": [{ name: "BJJ", type: "bjj-gi", label: "Todos Niveles (T2)", icon: "🥋" }]
    }
  },
  {
    id: "miercoles",
    name: "Miércoles",
    shortName: "MIÉ",
    slots: {
      "09:30": [{ name: "GRAP NOGI", type: "nogi", label: "Todos Niveles (T1)", icon: "🤼" }],
      "17:30": [{ name: "JUDO", type: "kids", label: "Kids 3-5 (T1)", icon: "👶" }],
      "18:30": [{ name: "JUDO", type: "kids", label: "6-12 Años (T2)", icon: "🥋" }],
      "19:00": [{ name: "BJJ", type: "bjj-gi", label: "Fundamentos (T1)", icon: "🥋" }],
      "19:30": [{ name: "JUDO", type: "judo", label: "Competición (T2)", icon: "🥋" }],
      "20:00": [{ name: "BJJ", type: "bjj-gi", label: "Avanzados (T1)", icon: "🥋" }]
    }
  },
  {
    id: "jueves",
    name: "Jueves",
    shortName: "JUE",
    slots: {
      "09:30": [{ name: "BJJ", type: "tatami", label: "Open Matt (T1)", icon: "✋" }],
      "15:00": [{ name: "BJJ", type: "bjj-gi", label: "Todos Niveles (T1)", icon: "🥋" }],
      "18:00": [{ name: "BJJ", type: "kids", label: "Kids 5-11 (T2)", icon: "👶" }],
      "19:00": [{ name: "GRAP NOGI", type: "nogi", label: "Todos Niveles (T2)", icon: "🤼" }]
    }
  },
  {
    id: "viernes",
    name: "Viernes",
    shortName: "VIE",
    slots: {
      "09:30": [{ name: "BJJ", type: "bjj-gi", label: "Todos Niveles (T1)", icon: "🥋" }],
      "17:30": [{ name: "JUDO", type: "kids", label: "Kids 3-5 (T1)", icon: "👶" }],
      "18:30": [{ name: "JUDO", type: "kids", label: "6-12 Años (T2)", icon: "🥋" }],
      "19:00": [{ name: "BJJ", type: "bjj-gi", label: "Competición (T1)", icon: "🥋" }],
      "19:30": [{ name: "JUDO", type: "judo", label: "Competición (T2)", icon: "🥋" }]
    }
  },
  {
    id: "sabado",
    name: "Sábado",
    shortName: "SÁB",
    slots: {
      "10:00": [{ name: "BJJ", type: "tatami", label: "Open Matt (T1)", icon: "✋" }]
    }
  }
];

const faqs = [
  {
    q: "¿Por qué el club se llama 'Chidaoba'?",
    a: "'Chidaoba' es el nombre del estilo tradicional de lucha de Georgia, famoso por sus agarres dinámicos y derribos que enriquecieron al judo moderno. Es la denominación elegida por la familia Cases para este proyecto de artes marciales en Alicante, integrando Judo Olímpico de élite, Brazilian Jiu-Jitsu (BJJ) con Mirco Biscarini y acondicionamiento marcial avanzado.",
    qKey: "faqs.q1",
    aKey: "faqs.a1"
  },
  {
    q: "¿Cuáles son los horarios de las clases y cómo puedo empezar?",
    a: "Ofrecemos clases distribuidas en turnos de mañana (09:30 Tatami Abierto y 10:00 Judo Olímpico / BJJ Gi / No-Gi), mediodía (15:00 BJJ), tarde para niños y jóvenes (17:30 y 18:30 Judo Kids & Juniors y BJJ Femenino) y noche para adultos y competición (19:30 y 20:45 Judo Olímpico y No-Gi). ¡Tu primera clase de prueba es 100% gratis! Escríbenos por WhatsApp para reservar tu hueco en el horario que prefieras.",
    qKey: "faqs.q2",
    aKey: "faqs.a2"
  },
  {
    q: "¿Quién imparte las clases de Judo y quién las de BJJ?",
    a: "Las clases de Judo Olímpico e infantil están dirigidas personalmente por Salvador Cases (Olímpico en París 2024 y Subcampeón de Europa) y Carlos Cases (Maestro Nacional y Campeón de España en todas las categorías). Las clases de Brazilian Jiu-Jitsu están lideradas por Mirco Biscarini (@mibisjj), Cinturón Negro y Campeón de Europa de BJJ (Team Kong / Team Kurama).",
    qKey: "faqs.q3",
    aKey: "faqs.a3"
  },
  {
    q: "¿Puedo entrenar tanto Judo como BJJ con la misma cuota?",
    a: "¡Sí! Disponemos de tarifa plana combinada ilimitada para que puedas entrenar indistintamente tanto Judo Olímpico como Brazilian Jiu-Jitsu (con Gi y No-Gi Grappling), además de acceso libre a todas las sesiones de Tatami Abierto y Open Mat en nuestras dos plantas.",
    qKey: "faqs.q4",
    aKey: "faqs.a4"
  },
  {
    q: "¿Puedo empezar desde cero si nunca he hecho artes marciales?",
    a: "¡Por supuesto! El 70% de nuestros alumnos comienzan sin experiencia marcial previa. Nuestro método de enseñanza progresivo prioriza aprender a caer con seguridad (ukemi), el control biomecánico y el respeto entre compañeros, para disfrutar desde el primer día sin riesgo de lesiones.",
    qKey: "faqs.q5",
    aKey: "faqs.a5"
  },
  {
    q: "¿Dónde está ubicado el club en Alicante?",
    a: "Estamos en la Calle de Perú, 14 (Planta G), 03008 Alicante. Una ubicación excelente, con fácil acceso, zona de aparcamiento y muy buenas conexiones de transporte público.",
    qKey: "faqs.q6",
    aKey: "faqs.a6"
  }
];
---

<section id="horarios" class="py-20 md:py-28 relative bg-[#F8F9FA] dark:bg-[#050505] border-t border-zinc-200 dark:border-white/10 overflow-hidden transition-colors duration-300">
  <div id="faq" class="absolute -top-20"></div>

  <!-- Ambient lighting -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[900px] h-[500px] bg-red-600/[0.04] dark:bg-red-600/[0.07] blur-[180px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header matching poster aesthetic with subtle BJJ logos -->
    <div class="text-center max-w-4xl mx-auto mb-12 space-y-4">
      
      <!-- Top Affiliation Logos (Team Kurama Left | Team Kong Right) -->
      <div class="flex items-center justify-between sm:justify-center sm:gap-8 md:gap-14 mb-2 px-2">
        <!-- Left Logo: Team Kurama (Subtle) -->
        <div class="flex items-center gap-2.5 group">
          <img
            src={`${base}/images/logo_team_kurama.png`}
            alt="Logo Team Kurama Brazilian Jiu-Jitsu"
            class="w-14 h-14 sm:w-16 sm:h-16 md:w-20 md:h-20 object-contain drop-shadow-[0_0_15px_rgba(220,38,38,0.35)] opacity-85 group-hover:opacity-100 transition-all duration-300"
            loading="lazy"
          />
          <div class="hidden sm:block text-left">
            <span class="block text-[11px] font-black uppercase tracking-wider text-red-500 font-display">TEAM KURAMA</span>
            <span class="block text-[10px] text-zinc-500 dark:text-zinc-400 font-medium">BJJ Affiliate</span>
          </div>
        </div>

        <!-- Center Badge -->
        <div class="flex flex-col items-center">
          <div data-i18n="schedule.badge" class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-red-600 text-white shadow-lg shadow-red-600/30">
            PLANIFICA TU SEMANA
          </div>
        </div>

        <!-- Right Logo: Team Kong (Subtle) -->
        <div class="flex items-center gap-2.5 group">
          <div class="hidden sm:block text-right">
            <span class="block text-[11px] font-black uppercase tracking-wider text-zinc-800 dark:text-white font-display">TEAM KONG</span>
            <span class="block text-[10px] text-zinc-500 dark:text-zinc-400 font-medium">Jiu-Jitsu Academy</span>
          </div>
          <img
            src={`${base}/images/logo_team_kong.png`}
            alt="Logo Team Kong Brazilian Jiu-Jitsu"
            class="w-14 h-14 sm:w-16 sm:h-16 md:w-20 md:h-20 object-contain drop-shadow-[0_0_15px_rgba(0,0,0,0.15)] dark:drop-shadow-[0_0_15px_rgba(255,255,255,0.15)] opacity-85 group-hover:opacity-100 transition-all duration-300"
            loading="lazy"
          />
        </div>
      </div>

      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black font-display text-zinc-900 dark:text-white tracking-tight uppercase">
        <span data-i18n="schedule.title">HORARIOS OFICIALES</span> <span class="text-silver-gradient">CHIDAOBA</span>
      </h2>

      <p data-i18n="schedule.subtitle" class="text-sm sm:text-base md:text-lg text-zinc-600 dark:text-zinc-300 font-medium tracking-wide">
        Clases de Judo Olímpico, Brazilian Jiu-Jitsu (Gi & No-Gi), Kids y Tatami Abierto de Lunes a Sábado dirigidas por Salvador Cases, Carlos Cases y Mirco Biscarini.
      </p>

      <!-- Affiliation Tagline matching the poster footer -->
      <div class="pt-1 flex items-center justify-center">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-xl bg-zinc-200/60 dark:bg-white/[0.03] border border-zinc-300 dark:border-white/10 text-[11px] sm:text-xs font-bold tracking-wider text-zinc-700 dark:text-zinc-300 uppercase">
          <span class="text-red-500 font-black">🥋</span>
          <span>Kong Jiu-Jitsu Academy · Team Kurama Affiliate</span>
        </span>
      </div>

      <!-- Subtitle badge: First class free -->
      <div data-i18n-html="schedule.badgeTrial" class="inline-flex items-center gap-2 px-4 py-1 rounded-full bg-emerald-500/10 dark:bg-white/5 border border-emerald-500/20 dark:border-white/15 text-xs text-zinc-700 dark:text-zinc-300">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <strong class="text-zinc-900 dark:text-white">Empieza hoy</strong> · Tu primera clase es 100% gratis
      </div>
    </div>

    <!-- Filter Pills / Categories -->
    <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-2.5 mb-8">
      <button
        type="button"
        data-filter="all"
        data-i18n="schedule.filterAll"
        class="filter-pill active px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-xl text-xs sm:text-sm uppercase tracking-wider transition-all"
      >
        Todas las Clases
      </button>
      <button
        type="button"
        data-filter="judo"
        data-i18n="schedule.filterJudo"
        class="filter-pill px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-xl text-xs sm:text-sm uppercase tracking-wider transition-all"
      >
        🥋 Judo Olímpico
      </button>
      <button
        type="button"
        data-filter="bjj-gi"
        data-i18n="schedule.filterBjjGi"
        class="filter-pill px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-xl text-xs sm:text-sm uppercase tracking-wider transition-all"
      >
        🥋 BJJ Gi
      </button>
      <button
        type="button"
        data-filter="nogi"
        data-i18n="schedule.filterNoGi"
        class="filter-pill px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-xl text-xs sm:text-sm uppercase tracking-wider transition-all"
      >
        🤼 No-Gi
      </button>
      <button
        type="button"
        data-filter="kids"
        data-i18n="schedule.filterKids"
        class="filter-pill px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-xl text-xs sm:text-sm uppercase tracking-wider transition-all"
      >
        👶 Judo Kids & Juniors
      </button>
      <button
        type="button"
        data-filter="femenino"
        data-i18n="schedule.filterWomen"
        class="filter-pill px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-xl text-xs sm:text-sm uppercase tracking-wider transition-all"
      >
        👩 BJJ Femenino
      </button>
      <button
        type="button"
        data-filter="tatami"
        data-i18n="schedule.filterOpenMat"
        class="filter-pill px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-xl text-xs sm:text-sm uppercase tracking-wider transition-all"
      >
        ✋ Tatami Abierto
      </button>
    </div>

    <!-- Mobile View Switcher (Visible on small screens) -->
    <div class="flex sm:hidden items-center justify-center gap-2 mb-6">
      <div class="bg-zinc-200/90 dark:bg-zinc-900/90 p-1 rounded-2xl border border-zinc-300 dark:border-white/15 flex items-center shadow-inner">
        <button
          id="btn-view-day"
          type="button"
          data-i18n="schedule.viewDay"
          class="px-3.5 py-1.5 rounded-xl text-xs font-black uppercase tracking-wider transition-all bg-red-600 text-white shadow-md"
        >
          📱 Vista por Día
        </button>
        <button
          id="btn-view-table"
          type="button"
          data-i18n="schedule.viewTable"
          class="px-3.5 py-1.5 rounded-xl text-xs font-bold uppercase tracking-wider transition-all text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white"
        >
          🗓️ Tabla Semanal
        </button>
      </div>
    </div>

    <!-- MOBILE DAY-BY-DAY VIEW (Default on mobile) -->
    <div id="mobile-day-view" class="block sm:hidden mb-12 relative overflow-hidden">
      <!-- Subtle Mobile Background Watermarks -->
      <div class="absolute -left-10 top-24 w-44 h-44 pointer-events-none opacity-[0.05] select-none z-0">
        <img src={`${base}/images/logo_team_kurama.png`} alt="" class="w-full h-full object-contain" />
      </div>
      <div class="absolute -right-10 bottom-16 w-44 h-44 pointer-events-none opacity-[0.05] select-none z-0">
        <img src={`${base}/images/logo_team_kong.png`} alt="" class="w-full h-full object-contain" />
      </div>

      <!-- Day selector tabs -->
      <div class="grid grid-cols-6 gap-1 mb-4 p-1 rounded-2xl bg-zinc-200/80 dark:bg-black/60 border border-zinc-300 dark:border-white/15 relative z-10">
        {daysData.map((d, index) => (
          <button
            type="button"
            data-day-tab={d.id}
            class={`day-tab-btn py-2 text-center rounded-xl transition-all ${
              index === 0 
                ? 'active bg-zinc-900 text-white dark:bg-white dark:text-black font-black shadow-md' 
                : 'text-zinc-600 dark:text-zinc-400 font-bold hover:text-zinc-950 dark:hover:text-white'
            }`}
          >
            <span class="block text-xs uppercase tracking-tighter">{d.shortName}</span>
          </button>
        ))}
      </div>

      <!-- Day content cards -->
      {daysData.map((d, index) => (
        <div
          id={`day-panel-${d.id}`}
          class={`day-panel space-y-3 ${index === 0 ? 'block' : 'hidden'}`}
        >
          <div class="flex items-center justify-between pb-2 border-b border-zinc-200 dark:border-white/10">
            <h3 class="text-xl font-black text-zinc-900 dark:text-white uppercase font-display flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-red-600"></span>
              {d.name}
            </h3>
            <span class="text-xs text-zinc-500 dark:text-zinc-400 font-semibold">{Object.values(d.slots).flat().length} clases</span>
          </div>

          <div class="space-y-2.5">
            {times.map(t => {
              const slots = d.slots[t as keyof typeof d.slots];
              if (!slots || slots.length === 0) {
                return null;
              }

              return slots.map(slot => {
                const isFemenino = slot.type === 'femenino';
                const isBJJGi = slot.type === 'bjj-gi';
                const isNoGi = slot.type === 'nogi';
                const isJudo = slot.name === 'JUDO' || slot.type === 'judo';
                const isKids = slot.type === 'kids';

                const waSlotMsg = encodeURIComponent(`¡Hola! Quiero reservar una clase gratis de ${slot.name} (${d.name} a las ${t}) en Chidaoba Alicante.`);

                const accentBorder = isJudo 
                  ? 'border-l-blue-600' 
                  : isBJJGi 
                    ? 'border-l-red-600' 
                    : isKids 
                      ? 'border-l-amber-500' 
                      : isFemenino 
                        ? 'border-l-rose-500' 
                        : isNoGi 
                          ? 'border-l-zinc-700 dark:border-l-zinc-300' 
                          : 'border-l-emerald-600';

                const timeBadge = isJudo 
                  ? 'bg-blue-600 text-white' 
                  : isBJJGi 
                    ? 'bg-red-600 text-white' 
                    : isKids 
                      ? 'bg-amber-500 text-zinc-950 font-black' 
                      : isFemenino 
                        ? 'bg-rose-600 text-white' 
                        : isNoGi 
                          ? 'bg-zinc-800 text-white dark:bg-zinc-700' 
                          : 'bg-emerald-600 text-white';

                const disciplineTag = isJudo && isKids
                  ? { label: 'JUDO KIDS', cls: 'bg-blue-100 text-blue-800 dark:bg-blue-950/80 dark:text-blue-300 border border-blue-200 dark:border-blue-800/50' }
                  : isJudo
                    ? { label: 'JUDO', cls: 'bg-blue-100 text-blue-800 dark:bg-blue-950/80 dark:text-blue-300 border border-blue-200 dark:border-blue-800/50' }
                    : isBJJGi
                      ? { label: 'BJJ', cls: 'bg-red-100 text-red-800 dark:bg-red-950/80 dark:text-red-300 border border-red-200 dark:border-red-800/50' }
                      : isKids
                        ? { label: 'BJJ KIDS', cls: 'bg-amber-100 text-amber-900 dark:bg-amber-950/80 dark:text-amber-300 border border-amber-200 dark:border-amber-800/50' }
                        : isFemenino
                          ? { label: 'FEMENINO', cls: 'bg-rose-100 text-rose-800 dark:bg-rose-950/80 dark:text-rose-300 border border-rose-200 dark:border-rose-800/50' }
                          : isNoGi
                            ? { label: 'NO-GI', cls: 'bg-zinc-200 text-zinc-800 dark:bg-white/10 dark:text-zinc-200 border border-zinc-300 dark:border-white/15' }
                            : { label: 'OPEN MAT', cls: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/50' };

                return (
                  <div
                    data-slot-type={slot.name === 'JUDO' ? `${slot.type} judo` : slot.type}
                    data-slot-name={slot.name}
                    data-filter-label={slot.label}
                    class={`schedule-card-mobile p-3.5 sm:p-4 rounded-2xl flex items-center justify-between gap-3 bg-white dark:bg-[#111116] border border-zinc-200 dark:border-white/10 border-l-4 ${accentBorder} shadow-sm hover:shadow-md transition-all active:scale-[0.99]`}
                  >
                    <div class="flex items-center gap-3 min-w-0">
                      <!-- Time pill -->
                      <div class={`px-2.5 py-1 rounded-xl font-mono text-xs sm:text-sm font-black shrink-0 shadow-sm ${timeBadge}`}>
                        {t}
                      </div>

                      <div class="min-w-0">
                        <div class="flex items-center gap-1.5 flex-wrap">
                          <span class="text-sm shrink-0">
                            {slot.icon}
                          </span>
                          <h4 data-slot-name={slot.name} class="slot-name-text text-sm font-black tracking-wide uppercase text-zinc-900 dark:text-white truncate">
                            {slot.name}
                          </h4>
                          <!-- Discipline Tag Badge -->
                          <span class={`text-[10px] font-black uppercase px-1.5 py-0.5 rounded-md ${disciplineTag.cls}`}>
                            {disciplineTag.label}
                          </span>
                        </div>
                        <p data-slot-label={slot.label} class="slot-label-text text-xs text-zinc-600 dark:text-zinc-400 font-medium truncate mt-0.5">
                          {slot.label}
                        </p>
                      </div>
                    </div>

                    <a
                      href={`https://wa.me/${whatsappNumber}?text=${waSlotMsg}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-wa-slot
                      data-wa-slot-name={slot.name}
                      data-slot-day={d.name}
                      data-slot-time={t}
                      class="shrink-0 px-3 py-1.5 rounded-xl text-xs font-black uppercase tracking-wider bg-red-600 hover:bg-red-500 text-white shadow-sm shadow-red-600/30 active:scale-95 transition-all inline-flex items-center gap-1"
                    >
                      <span data-i18n="schedule.bookBtn">Reservar</span>
                      <span class="text-[10px]">&rarr;</span>
                    </a>
                  </div>
                );
              });
            })}
          </div>
        </div>
      ))}
    </div>

    <!-- DESKTOP & FULL TABLE VIEW -->
    <div id="full-table-view" class="hidden sm:block mb-12">
      <!-- Legend of Disciplines -->
      <div class="flex flex-wrap items-center justify-between text-xs text-zinc-600 dark:text-zinc-300 gap-3 mb-3 px-2">
        <div class="flex flex-wrap items-center gap-4">
          <span class="flex items-center gap-1.5 font-semibold">
            <span class="w-3 h-3 rounded-full bg-blue-600 border border-blue-400"></span>
            <span data-i18n="schedule.legendJudo">Judo Olímpico</span>
          </span>
          <span class="flex items-center gap-1.5 font-semibold">
            <span class="w-3 h-3 rounded-full bg-white border border-zinc-400"></span>
            <span data-i18n="schedule.legendBjjGi">BJJ Gi</span>
          </span>
          <span class="flex items-center gap-1.5 font-semibold">
            <span class="w-3 h-3 rounded-full bg-zinc-800 border border-white/30"></span>
            <span data-i18n="schedule.legendNoGi">No-Gi</span>
          </span>
          <span class="flex items-center gap-1.5 font-semibold">
