                                          : 'bg-zinc-100 text-zinc-800 dark:bg-white/[0.04] dark:text-zinc-200 border border-zinc-200 dark:border-white/10 hover:border-zinc-400 dark:hover:border-white/25 hover:bg-zinc-200 dark:hover:bg-white/[0.07]'
                              }`}
                              title={`Reservar ${slot.name} - ${d.name} ${t}`}
                            >
                              <!-- Icon -->
                              <div class="text-sm sm:text-base mb-0.5 group-hover:scale-110 transition-transform">
                                {slot.icon}
                              </div>

                              <!-- Class Name -->
                              <span data-slot-name={slot.name} class={`slot-name-text text-[11px] sm:text-xs font-black leading-tight tracking-wider uppercase block ${
                                isBJJGi ? 'text-zinc-950' : isJudo ? 'text-blue-100' : isKids ? 'text-amber-200' : 'text-white'
                              }`}>
