---
// src/components/Hero.astro
import Countdown from './Countdown.astro';

const whatsappNumber = "34600000000";
const whatsappText = encodeURIComponent("¡Hola Salva, Carlos y Mirco! Quiero consultar los horarios y solicitar una clase de prueba en CHIDAOBA Alicante.");
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappText}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="proyecto" class="relative pt-10 pb-20 md:pt-16 md:pb-28 overflow-hidden">
  <!-- Dynamic background spotlights with subtle pulse -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] sm:w-[900px] h-[450px] bg-white/[0.04] blur-[140px] rounded-full pointer-events-none animate-pulse-subtle"></div>
  <div class="absolute bottom-10 right-10 w-[400px] h-[400px] bg-red-600/[0.12] blur-[140px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy, Highlights & CTAs -->
      <div class="lg:col-span-7 flex flex-col items-start text-left space-y-6">
        
        <!-- Badges with animations -->
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-red-600 text-white shadow-lg shadow-red-600/30">
            <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
            <span data-i18n="hero.badge1">JUDO OLÍMPICO & BJJ</span>
          </span>
          <span data-i18n="hero.badge2" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold text-zinc-300 bg-white/5 border border-white/15 hover:border-white/40 transition-colors">
            📍 Alicante · C/ de Perú, 14 (Planta G)
          </span>
          <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold text-white bg-black/70 border border-white/20">
            <span>🥋 Salva Cases · Carlos Cases ·</span>
            <span class="text-red-400 font-black">Mirco Biscarini</span>
          </span>
        </div>

        <!-- Main Title -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black font-display tracking-tight text-white leading-[1.06]">
          <span data-i18n="hero.titlePre">CLUB DEPORTIVO</span> <br />
          <span class="text-silver-gradient text-5xl sm:text-6xl md:text-7xl drop-shadow-2xl font-black">CHIDAOBA</span> <br />
          <span class="text-white relative inline-block text-3xl sm:text-4xl md:text-5xl mt-1">
            <span data-i18n="hero.titleSuffix">JUDO OLÍMPICO &</span> <span class="text-red-500 font-black">BJJ</span>
            <span class="absolute -bottom-1 left-0 w-full h-1.5 bg-gradient-to-r from-red-600 via-red-500 to-white/40 rounded-full"></span>
          </span>
        </h1>

        <!-- Subtitle -->
        <p data-i18n-html="hero.subtitle" class="text-base sm:text-lg text-zinc-300 max-w-2xl leading-relaxed font-normal">
          El centro de referencia en combate y grappling de los hermanos <strong>Salvador Cases</strong> (Olímpico París 2024, Subcampeón de Europa) y <strong>Carlos Cases</strong> (Campeón de España y Maestro Nacional), junto al Campeón de Europa de BJJ <strong class="text-red-400">Mirco Biscarini</strong> (@mibisjj) en Alicante.
        </p>

        <!-- Training & Level Info Strip -->
        <div class="w-full max-w-xl p-4 rounded-2xl bg-white/[0.02] border border-white/10 flex items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-red-600/20 text-red-500 border border-red-500/30 flex items-center justify-center font-black text-lg">
              🥋
            </div>
            <div>
              <p data-i18n="hero.stripTitle" class="text-xs font-black text-white uppercase tracking-wider">Clases Abiertas · Todos los Niveles</p>
              <p data-i18n="hero.stripDesc" class="text-[11px] text-zinc-400">Iniciación, infantil, adultos y competición con atletas olímpicos</p>
            </div>
          </div>
          <a href="#horarios" data-i18n="hero.stripCta" class="text-xs font-black text-red-400 hover:text-red-300 shrink-0 border border-red-500/30 px-3.5 py-1.5 rounded-xl bg-red-600/10 hover:bg-red-600/20 transition-colors">
            Ver Horarios &rarr;
          </a>
        </div>

        <!-- CTA Buttons -->
        <div class="w-full sm:w-auto flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
          <a
            id="hero-wa-btn"
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl text-base font-extrabold text-white bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 shadow-xl shadow-red-600/30 hover:shadow-red-500/50 hover:-translate-y-0.5 transition-all duration-200 animate-pulse-glow"
          >
            <!-- WhatsApp Icon -->
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span data-i18n="hero.ctaTrial">Solicitar Clase de Prueba</span>
            <span class="group-hover:translate-x-1.5 transition-transform duration-200">&rarr;</span>
          </a>

          <a
            href="#horarios"
            data-i18n="hero.ctaSchedule"
            class="inline-flex items-center justify-center px-7 py-4 rounded-2xl text-base font-bold text-white bg-white/5 hover:bg-white/10 border border-white/15 hover:border-white/40 transition-all duration-200"
          >
            Ver Horarios de Clases
          </a>
        </div>

        <!-- Trust badges -->
        <div class="pt-2 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs text-zinc-300 font-medium">
          <div class="flex items-center gap-2">
            <span class="text-red-500 font-black">✓</span>
            <span data-i18n="hero.trust1">Clase de prueba sin compromiso</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-red-500 font-black">✓</span>
            <span data-i18n="hero.trust2">Desde iniciación a competición</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-red-500 font-black">✓</span>
            <span data-i18n="hero.trust3">2 Tatamis (100m² + 70m²)</span>
          </div>
        </div>

      </div>

      <!-- Right Column: REAL Photos of Salvador Cases in Action & Schedule Snapshot -->
      <div class="lg:col-span-5 flex flex-col space-y-6">
        
        <!-- REAL Action Photo Card of Salvador Cases -->
        <div class="relative rounded-3xl overflow-hidden border border-white/15 hover:border-white/30 transition-all shadow-card-elevated group">
          <img
            src={`${base}/images/salva_competition_1.jpg`}
            alt="Salvador Cases en la final del Gran Premio de Judo"
            class="w-full h-80 sm:h-96 object-cover object-top group-hover:scale-105 transition-transform duration-700"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#050505] via-transparent to-black/40"></div>
          
          <!-- Live Action Tag -->
          <div class="absolute top-4 left-4 bg-red-600 text-white font-black text-[10px] tracking-widest uppercase px-3 py-1 rounded-full flex items-center gap-1.5 shadow-md">
            <span class="w-1.5 h-1.5 rounded-full bg-white animate-ping"></span>
            <span data-i18n="hero.photoBadge">FOTO REAL EN COMPETICIÓN</span>
          </div>

          <div class="absolute top-4 right-4 bg-black/80 backdrop-blur-md px-3.5 py-1.5 rounded-full border border-white/20 text-[11px] font-extrabold text-white flex items-center gap-1.5">
            <span>🥋</span>
            <span>WORLD JUDO TOUR</span>
          </div>

          <!-- Bottom caption inside image -->
          <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <img
                src={`${base}/images/salva_profile_ijf.jpg`}
                alt="Salvador Cases perfil oficial IJF"
                class="w-11 h-11 rounded-full border-2 border-white/40 object-cover shadow-lg shrink-0"
              />
              <div>
                <p class="text-xs uppercase tracking-widest text-white font-black">SALVADOR CASES</p>
                <p data-i18n="hero.photoRole" class="text-xs font-bold text-zinc-300">Olímpico París 2024 · Subcampeón Europa</p>
              </div>
            </div>
            <div class="bg-red-600 text-white font-black text-xs px-3 py-1.5 rounded-xl uppercase tracking-wider shadow-md">
              CHIDAOBA
            </div>
          </div>
        </div>

        <!-- Live Countdown Timer Card -->
        <Countdown />
      </div>

    </div>
  </div>
</section>
