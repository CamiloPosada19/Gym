---
// src/components/WhatsAppButton.astro
interface Props {
  phone?: string;
  defaultMessage?: string;
}

const {
  phone = "34610046042",
  defaultMessage = "¡Hola Salva, Carlos, Mirco y Luis! Quiero consultar los horarios de Judo y BJJ en CHIDAOBA Alicante y solicitar una clase de prueba."
} = Astro.props;

const whatsappUrl = `https://wa.me/${phone}?text=${encodeURIComponent(defaultMessage)}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!-- Floating WhatsApp Widget -->
<div class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-3 group">
  
  <!-- Floating Callout Card / Tooltip (Desktop only) -->
  <div
    id="wa-bubble"
    class="hidden lg:block opacity-0 translate-y-3 pointer-events-none transition-all duration-500 ease-out max-w-xs p-4 rounded-2xl bg-white/95 dark:bg-zinc-950/95 backdrop-blur-xl border border-zinc-200 dark:border-white/15 shadow-2xl text-zinc-900 dark:text-zinc-100 relative"
  >
    <button
      id="wa-close-bubble"
      type="button"
      class="absolute top-2 right-2 text-zinc-400 hover:text-zinc-800 dark:hover:text-white text-xs p-1"
      aria-label="Cerrar mensaje"
    >
      ✕
    </button>
    
    <div class="flex items-center gap-3 mb-2">
      <div class="relative shrink-0">
        <img
          src={`${base}/images/salva_profile_ijf.jpg`}
          alt="Salvador Cases foto perfil real"
          class="w-10 h-10 rounded-full object-cover border-2 border-white dark:border-white/40 shadow-md"
        />
        <span class="absolute bottom-0 right-0 w-3 h-3 rounded-full bg-red-500 border-2 border-white dark:border-[#09090C]"></span>
      </div>
      <div>
        <h5 class="text-xs font-black text-zinc-900 dark:text-white">Chidaoba Alicante</h5>
        <p class="text-[10px] text-red-600 dark:text-red-400 flex items-center gap-1 font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
          <span data-i18n="wa.online">Salva, Carlos, Mirco & Luis · En línea</span>
        </p>
      </div>
    </div>

    <p data-i18n-html="wa.bubbleText" class="text-xs text-zinc-600 dark:text-zinc-300 leading-snug">
      👋 ¡Hola! ¿Tienes dudas sobre los horarios o clases de <strong>Judo o BJJ</strong>? Escríbenos para consultar turnos o reservar tu <strong class="text-zinc-900 dark:text-white">clase de prueba</strong> sin compromiso.
    </p>

    <a
      id="wa-bubble-link"
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-3 inline-flex items-center justify-center w-full py-2.5 px-3 rounded-xl bg-red-600 hover:bg-red-500 text-white text-xs font-bold transition-all shadow-md shadow-red-600/30"
    >
      <span data-i18n="wa.bubbleBtn">Chatear por WhatsApp ahora</span>
    </a>
  </div>

  <!-- Mobile Floating Theme Toggle Button (Replaces WhatsApp button on mobile) -->
  <button
    id="theme-toggle-mobile"
    type="button"
    class="lg:hidden relative inline-flex items-center justify-center w-14 h-14 rounded-full bg-white dark:bg-[#121216] border border-zinc-300 dark:border-white/20 text-zinc-900 dark:text-white shadow-2xl shadow-black/15 dark:shadow-black/60 hover:scale-105 active:scale-95 transition-all select-none cursor-pointer"
    aria-label="Cambiar tema / Switch theme"
    title="Cambiar tema Claro/Oscuro"
  >
    <!-- Moon Icon (shown in light mode to switch to dark) -->
    <svg class="w-6 h-6 block dark:hidden fill-current" viewBox="0 0 24 24">
      <path d="M12.3 4.9c.4-.2.6-.7.5-1.1s-.6-.8-1-.7C6.4 3.7 2.6 8 3 13.4c.4 5.3 4.8 9.5 10.1 9.6 4.7.1 8.8-3 9.8-7.6.1-.4-.1-.9-.5-1.1-.4-.2-.9-.1-1.2.2-2.1 2.2-5.4 2.8-8.1 1.5-2.8-1.3-4.3-4.3-3.7-7.3.5-2.7 2.5-4.8 5.1-5.4.4-.1.7-.5.8-.9z"/>
    </svg>
    <!-- Sun Icon (shown in dark mode to switch to light) -->
    <svg class="w-6 h-6 hidden dark:block fill-current text-yellow-400" viewBox="0 0 24 24">
      <path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zm-6.07-14.93l1.41 1.41c.39.39 1.02.39 1.41 0 .39-.39.39-1.02 0-1.41L6.34 5.66c-.39-.39-1.02-.39-1.41 0-.39.39-.39 1.02 0 1.41zm12.73 12.73l1.41 1.41c.39.39 1.02.39 1.41 0 .39-.39.39-1.02 0-1.41l-1.41-1.41c-.39-.39-1.02-.39-1.41 0-.39.39-.39 1.02 0 1.41zM4.93 17.66l1.41-1.41c.39-.39.39-1.02 0-1.41-.39-.39-1.02-.39-1.41 0l-1.41 1.41c-.39.39-.39 1.02 0 1.41.39.39 1.02.39 1.41 0zm12.73-12.73c.39-.39.39-1.02 0-1.41-.39-.39-1.02-.39-1.41 0l-1.41 1.41c-.39.39-.39 1.02 0 1.41.39.39 1.02.39 1.41 0l1.41-1.41z"/>
    </svg>
  </button>

  <!-- Big Floating Action Button with ripple & bounce (Desktop only) -->
  <a
    id="wa-main-link"
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contactar por WhatsApp con los Hermanos Cases"
    class="hidden lg:inline-flex relative items-center justify-center w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-2xl shadow-emerald-500/50 hover:scale-110 active:scale-95 transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-emerald-400/40 animate-pulse-glow"
  >
    <!-- Ping Ring animation -->
    <span class="absolute -inset-1 rounded-full bg-[#25D366] opacity-40 animate-ping pointer-events-none"></span>
    
    <!-- WhatsApp Icon SVG -->
    <svg class="w-8 h-8 sm:w-9 sm:h-9 fill-current relative z-10" viewBox="0 0 24 24">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
    </svg>
  </a>
</div>

<script>
  setTimeout(() => {
    const bubble = document.getElementById('wa-bubble');
    if (bubble) {
      bubble.classList.remove('opacity-0', 'translate-y-3', 'pointer-events-none');
    }
  }, 2200);

  const closeBtn = document.getElementById('wa-close-bubble');
  if (closeBtn) {
    closeBtn.addEventListener('click', () => {
      const bubble = document.getElementById('wa-bubble');
      if (bubble) {
        bubble.classList.add('opacity-0', 'translate-y-3', 'pointer-events-none');
      }
    });
  }
</script>
