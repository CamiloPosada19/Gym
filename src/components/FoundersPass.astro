---
// src/components/FoundersPass.astro
const perks = [
  {
    title: "Acceso Combinado Judo + BJJ",
    desc: "Tarifa plana que te permite entrenar Judo Olímpico y Brazilian Jiu-Jitsu sin abonar cuotas dobles.",
    value: "TARIFA PLANA"
  },
  {
    title: "Clase de Prueba Sin Compromiso",
    desc: "Ven a probar una clase con nosotros para conocer las instalaciones, el tatami y a los maestros.",
    value: "PRUEBA GRATIS"
  },
  {
    title: "Todos los Niveles Bienvenidos",
    desc: "Desde personas que empiezan desde cero hasta competidores avanzados y cinturones negros.",
    value: "TODOS LOS NIVELES"
  },
  {
    title: "Seminarios & Masterclasses",
    desc: "Clases magistrales periódicas impartidas por Salvador Cases, Carlos Cases y Mirco Biscarini.",
    value: "ALTO NIVEL"
  },
  {
    title: "Zona de Fuerza & Calistenia",
    desc: "Acceso completo a materiales de tracción, barras olímpicas, cuerdas y kettlebells.",
    value: "INCLUIDO"
  },
  {
    title: "Descuento en Kimono / Judogi",
    desc: "Condiciones ventajosas en el uniforme y merchandising oficial de competición del club.",
    value: "DESCUENTO"
  }
];

const whatsappNumber = "34600000000"; // Teléfono ficticio para GitHub Pages
---

<section id="contacto" class="py-20 md:py-28 relative overflow-hidden bg-gradient-to-b from-[#050505] via-[#0A0A0E] to-[#050505]">
  <div id="unete" class="absolute -top-20"></div>
  <!-- Glow background -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] bg-red-600/[0.08] blur-[160px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-red-600 text-white shadow-lg shadow-red-600/30">
        ENTRENA EN CHIDAOBA · ALICANTE
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black font-display text-white tracking-tight">
        ÚNETE AL CLUB <span class="text-silver-gradient">CHIDAOBA</span>
      </h2>
      <p class="text-base sm:text-lg text-zinc-300">
        Comienza tu entrenamiento en el nuevo centro de referencia de artes marciales en Alicante. Consulta horarios, cuotas o agenda tu primera clase de prueba.
      </p>

      <!-- Trust indicator -->
      <div class="inline-flex items-center gap-3 px-5 py-2.5 rounded-2xl bg-white/[0.03] border border-white/15 text-sm shadow-md">
        <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
        <span class="text-zinc-300">Inscripciones y Matrícula:</span>
        <span class="font-extrabold text-white text-base">Abiertas para todos los niveles</span>
      </div>
    </div>

    <!-- Main 2-Column Grid: Perks List & Instant WhatsApp Form -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Perks List -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {perks.map(p => (
          <div class="glass-card p-5 rounded-2xl border border-white/10 hover:border-white/30 hover:-translate-y-0.5 transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] font-black uppercase tracking-wider text-zinc-200 bg-white/10 px-2.5 py-0.5 rounded border border-white/15">
                  {p.value}
                </span>
                <span class="text-red-500 text-sm font-bold">✓</span>
              </div>
              <h4 class="text-base font-bold text-white mb-1.5">{p.title}</h4>
              <p class="text-xs text-zinc-400 leading-relaxed">{p.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Quick WhatsApp Reservation Card -->
      <div class="lg:col-span-5">
        <div class="glass-card-dark p-6 sm:p-8 rounded-3xl border border-white/15 shadow-2xl relative">
          
          <div class="text-center mb-6">
            <span class="text-xs font-black uppercase tracking-widest text-red-400 block mb-1">
              CONTACTO DIRECTO SIN COMPROMISO
            </span>
            <h3 class="text-2xl font-black text-white font-display">
              Habla con los Entrenadores
            </h3>
            <p class="text-xs text-zinc-300 mt-1">
              Envía tu mensaje y Salvador, Carlos o Mirco te responderán directamente por WhatsApp para orientarte con los horarios y tu clase de prueba:
            </p>
          </div>

          <!-- Interactive Form that opens WhatsApp with custom payload -->
          <form id="founder-form" class="space-y-4">
            <div>
              <label for="f-name" class="block text-xs font-bold text-zinc-300 uppercase tracking-wider mb-1.5">
                Tu Nombre y Apellidos
              </label>
              <input
                type="text"
                id="f-name"
                name="name"
                required
                placeholder="Ej. Alejandro Gómez"
                class="w-full px-4 py-3 rounded-xl bg-black/60 border border-white/15 text-white placeholder-zinc-500 text-sm focus:outline-none focus:border-red-500 transition-colors"
              />
            </div>

            <div>
              <label for="f-interest" class="block text-xs font-bold text-zinc-300 uppercase tracking-wider mb-1.5">
                ¿Qué disciplina te interesa más?
              </label>
              <select
                id="f-interest"
                name="interest"
                class="w-full px-4 py-3 rounded-xl bg-black/60 border border-white/15 text-white text-sm focus:outline-none focus:border-red-500 transition-colors"
              >
                <option value="Judo y Brazilian Jiu-Jitsu (Pase Completo)">Judo y Brazilian Jiu-Jitsu (Pase Completo)</option>
                <option value="Solo Judo Olímpico">Solo Judo Olímpico</option>
                <option value="Solo Brazilian Jiu-Jitsu (Gi & No-Gi)">Solo Brazilian Jiu-Jitsu (Gi & No-Gi)</option>
                <option value="Clases Infantiles / Juniors (4 a 15 años)">Clases Infantiles / Juniors (4 a 15 años)</option>
              </select>
            </div>

            <div>
              <label for="f-level" class="block text-xs font-bold text-zinc-300 uppercase tracking-wider mb-1.5">
                ¿Cuál es tu nivel actual?
              </label>
              <select
                id="f-level"
                name="level"
                class="w-full px-4 py-3 rounded-xl bg-black/60 border border-white/15 text-white text-sm focus:outline-none focus:border-red-500 transition-colors"
              >
                <option value="Ninguno, empiezo totalmente desde cero">Ninguno, empiezo totalmente desde cero (Principiante)</option>
                <option value="He practicado algo de deportes de contacto">He practicado algo de deportes de contacto</option>
                <option value="He hecho Judo o BJJ anteriormente">He hecho Judo o BJJ anteriormente</option>
                <option value="Cinturón intermedio / Avanzado / Competidor">Cinturón intermedio / Avanzado / Competidor</option>
              </select>
            </div>

            <button
              type="submit"
              class="w-full mt-2 inline-flex items-center justify-center gap-3 px-6 py-4 rounded-xl text-base font-extrabold text-white bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 shadow-xl shadow-red-600/30 hover:scale-[1.01] active:scale-[0.99] transition-all"
            >
              <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
              <span>Enviar Consulta por WhatsApp</span>
            </button>
            <p class="text-[11px] text-center text-slate-400">
              🔒 Contacto directo con el equipo técnico de Chidaoba. Te responderemos personalmente en unos minutos.
            </p>
          </form>

        </div>
      </div>

    </div>

  </div>
</section>

<script define:vars={{ whatsappNumber }}>
  const form = document.getElementById('founder-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('f-name') as HTMLInputElement)?.value || '';
      const interest = (document.getElementById('f-interest') as HTMLSelectElement)?.value || '';
      const level = (document.getElementById('f-level') as HTMLSelectElement)?.value || '';

      const msg = `¡Hola Salva, Carlos y Mirco! Me llamo ${name}. Quiero consultar horarios y probar una clase en CHIDAOBA en "${interest}". Mi nivel de partida es: "${level}". ¿Cuándo podría pasarme por el tatami? ¡Un saludo!`;

      const encodedMsg = encodeURIComponent(msg);
      window.open(`https://wa.me/${whatsappNumber}?text=${encodedMsg}`, '_blank');
    });
  }
</script>
