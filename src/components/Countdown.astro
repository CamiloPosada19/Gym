---
// src/components/Countdown.astro
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

// Cálculo en servidor con zona horaria de España (CEST: UTC+2)
// Apertura oficial: 1 de octubre a las 00:00:00 en Alicante (España)
const now = new Date();
const currentYear = now.getFullYear();
let targetDate = new Date(`${currentYear}-10-01T00:00:00+02:00`);
if (now.getTime() >= targetDate.getTime()) {
  targetDate = new Date(`${currentYear + 1}-10-01T00:00:00+02:00`);
}

const diffMs = Math.max(0, targetDate.getTime() - now.getTime());
const initialDays = String(Math.floor(diffMs / (1000 * 60 * 60 * 24))).padStart(2, '0');
const initialHours = String(Math.floor((diffMs % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))).padStart(2, '0');
const initialMinutes = String(Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60))).padStart(2, '0');
const initialSeconds = String(Math.floor((diffMs % (1000 * 60)) / 1000)).padStart(2, '0');
const targetIsoString = targetDate.toISOString();
---

<div class={`glass-card p-6 rounded-3xl border border-white/10 shadow-card-elevated relative overflow-hidden ${className}`}>
  <!-- Decorative ambient lighting -->
  <div class="absolute -top-24 -left-24 w-48 h-48 bg-white/[0.03] rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -right-24 w-48 h-48 bg-red-600/[0.12] rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 flex flex-col items-center text-center">
    <!-- Header Badge -->
    <div data-i18n="countdown.badge" class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black tracking-widest uppercase bg-red-600/15 text-red-400 border border-red-500/30 mb-3">
      <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
      CUENTA ATRÁS · APERTURA 1 DE OCTUBRE
    </div>
    
    <!-- Title -->
    <h3 data-i18n="countdown.title" class="text-lg sm:text-xl md:text-2xl font-black text-white font-display tracking-tight mb-1.5">
      EL TATAMI ABRE SUS PUERTAS EN:
    </h3>
    <p data-i18n="countdown.subtitle" class="text-xs text-zinc-400 max-w-md mb-5">
      Estamos finalizando el acondicionamiento del nuevo dojo en Alicante para abrir el 1 de octubre. Asegura tu plaza antes del inicio de clases.
    </p>

    <!-- Digits Grid -->
    <div id="countdown-timer" data-target={targetIsoString} class="grid grid-cols-4 gap-2 sm:gap-3 w-full max-w-md">
      <!-- Days -->
      <div class="flex flex-col items-center bg-[#09090C] border border-white/10 rounded-2xl p-2.5 sm:p-3 shadow-inner relative group">
        <span id="cd-days" class="text-2xl sm:text-3xl md:text-4xl font-black text-white font-display tracking-tighter">{initialDays}</span>
        <span data-i18n="countdown.days" class="text-[10px] font-bold text-zinc-400 tracking-wider uppercase mt-0.5">Días</span>
      </div>

      <!-- Hours -->
      <div class="flex flex-col items-center bg-[#09090C] border border-white/10 rounded-2xl p-2.5 sm:p-3 shadow-inner relative group">
        <span id="cd-hours" class="text-2xl sm:text-3xl md:text-4xl font-black text-white font-display tracking-tighter">{initialHours}</span>
        <span data-i18n="countdown.hours" class="text-[10px] font-bold text-zinc-400 tracking-wider uppercase mt-0.5">Horas</span>
      </div>

      <!-- Minutes -->
      <div class="flex flex-col items-center bg-[#09090C] border border-white/10 rounded-2xl p-2.5 sm:p-3 shadow-inner relative group">
        <span id="cd-minutes" class="text-2xl sm:text-3xl md:text-4xl font-black text-white font-display tracking-tighter">{initialMinutes}</span>
        <span data-i18n="countdown.minutes" class="text-[10px] font-bold text-zinc-400 tracking-wider uppercase mt-0.5">Min</span>
      </div>

      <!-- Seconds -->
      <div class="flex flex-col items-center bg-[#09090C] border border-white/10 rounded-2xl p-2.5 sm:p-3 shadow-inner relative group">
        <span id="cd-seconds" class="text-2xl sm:text-3xl md:text-4xl font-black text-red-500 font-display tracking-tighter">{initialSeconds}</span>
        <span data-i18n="countdown.seconds" class="text-[10px] font-bold text-zinc-400 tracking-wider uppercase mt-0.5">Seg</span>
      </div>
    </div>

    <!-- Progress bar & spots -->
    <div class="w-full max-w-md mt-5 space-y-1.5">
      <div class="flex justify-between text-[11px] font-semibold text-zinc-400">
        <span data-i18n-html="countdown.progressText">Progreso de obras e instalaciones: <strong class="text-white">88%</strong></span>
        <span data-i18n="countdown.spotsText" class="text-red-400 font-bold">Plazas: 38/50 reservadas</span>
      </div>
      <div class="w-full h-2 bg-white/10 rounded-full overflow-hidden p-0.5">
        <div class="h-full bg-gradient-to-r from-red-700 via-red-600 to-red-500 rounded-full w-[76%] transition-all duration-1000"></div>
      </div>
    </div>

    <!-- Schedule quick link footer -->
    <div class="w-full max-w-md pt-3 mt-4 border-t border-white/10 flex items-center justify-between text-xs text-zinc-300">
      <span class="flex items-center gap-1.5 font-medium">
        📍 C/ de Perú, 14 (Alicante)
      </span>
      <a href="#horarios" data-i18n="countdown.schedLink" class="font-extrabold text-red-400 hover:text-red-300 transition-colors flex items-center gap-1">
        Ver Horarios de Clases &rarr;
      </a>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var timerContainer = document.getElementById('countdown-timer');
    var targetIso = timerContainer ? timerContainer.getAttribute('data-target') : null;

    function getTargetDate() {
      if (targetIso) {
        var parsed = new Date(targetIso);
        if (!isNaN(parsed.getTime())) return parsed;
      }
      var now = new Date();
      var currentYear = now.getFullYear();
      var target = new Date(currentYear + '-10-01T00:00:00+02:00');
      if (now.getTime() >= target.getTime()) {
        target = new Date((currentYear + 1) + '-10-01T00:00:00+02:00');
      }
      return target;
    }

    var targetDate = getTargetDate();

    function updateTimer() {
      var now = Date.now();
      var distance = targetDate.getTime() - now;

      var elDays = document.getElementById('cd-days');
      var elHours = document.getElementById('cd-hours');
      var elMinutes = document.getElementById('cd-minutes');
      var elSeconds = document.getElementById('cd-seconds');

      if (!elDays || !elHours || !elMinutes || !elSeconds) return;

      if (distance <= 0) {
        elDays.textContent = '00';
        elHours.textContent = '00';
        elMinutes.textContent = '00';
        elSeconds.textContent = '00';
        return;
      }

      var days = Math.floor(distance / (1000 * 60 * 60 * 24));
      var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      var seconds = Math.floor((distance % (1000 * 60)) / 1000);

      elDays.textContent = String(days).padStart(2, '0');
      elHours.textContent = String(hours).padStart(2, '0');
      elMinutes.textContent = String(minutes).padStart(2, '0');
      elSeconds.textContent = String(seconds).padStart(2, '0');
    }

    // Ejecutar inmediatamente para corregir cualquier valor estático de SSR/SSG
    updateTimer();

    // Iniciar intervalo de actualización en vivo cada segundo
    var timerInterval = setInterval(updateTimer, 1000);

    // Resincronizar cuando la página termine de cargar o la pestaña vuelva a estar activa
    document.addEventListener('DOMContentLoaded', updateTimer);
    window.addEventListener('pageshow', updateTimer);
    window.addEventListener('focus', updateTimer);
    document.addEventListener('visibilitychange', function () {
      if (!document.hidden) {
        updateTimer();
      }
    });
  })();
</script>
