---
// src/components/Facility.astro
const features = [
  {
    icon: "🛡️",
    title: "250m² Tatami Oficial Amortiguado",
    desc: "Superficie de competición de alta densidad con cámara de absorción anti-impactos diseñada para proteger articulaciones en proyecciones y rodajes intensos.",
    titleKey: "facility.f1Title",
    descKey: "facility.f1Desc"
  },
  {
    icon: "🏋️",
    title: "Zona de Fuerza & Calistenia",
    desc: "Cuerdas de trepar hasta el techo, barras olímpicas, kettlebells, racks y material para tracción y grip específico para judokas y jiu-jitseros.",
    titleKey: "facility.f2Title",
    descKey: "facility.f2Desc"
  },
  {
    icon: "🚿",
    title: "Vestuarios Amplios & Nuevos",
    desc: "Duchas individuales, zonas de taquillas, limpieza y desinfección diaria bajo los más estrictos estándares higiénicos.",
    titleKey: "facility.f3Title",
    descKey: "facility.f3Desc"
  },
  {
    icon: "📍",
    title: "C/ de Perú, 14 (Planta G), 03008 Alicante",
    desc: "Nueva sede de Chidaoba en Alicante, con fácil acceso, zona de aparcamiento y excelentes conexiones de transporte para entrenar al máximo nivel.",
    titleKey: "facility.f4Title",
    descKey: "facility.f4Desc"
  }
];
---

<section id="instalaciones" class="py-20 md:py-28 relative bg-[#050505] border-t border-white/10 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div data-i18n="facility.badge" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-white/10 text-white border border-white/20">
        NUESTRO ESPACIO EN ALICANTE
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black font-display text-white tracking-tight">
        <span data-i18n="facility.title">INSTALACIONES DISEÑADAS PARA EL</span> <span data-i18n="facility.titleHighlight" class="text-silver-gradient">ALTO NIVEL</span>
      </h2>
      <p data-i18n="facility.subtitle" class="text-base sm:text-lg text-zinc-300">
        Ubicado en C/ de Perú, 14 (Planta G), 03008 Alicante. Más de 300 m² dedicados exclusivamente al judo, al brazilian jiu-jitsu y a la preparación física funcional.
      </p>
    </div>

    <!-- Big Image Display -->
    <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-card-elevated mb-12 group">
      <img
        src={`${import.meta.env.BASE_URL}images/gym_dojo_interior.jpg`}
        alt="Interior del nuevo dojo Chidaoba en Alicante"
        class="w-full h-80 sm:h-[480px] object-cover object-center group-hover:scale-102 transition-transform duration-700"
      />
      
      <!-- Overlay details -->
      <div class="absolute inset-0 bg-gradient-to-t from-[#050505] via-transparent to-black/30"></div>

      <div class="absolute bottom-6 left-6 right-6 flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4">
        <div class="space-y-1">
          <span data-i18n="facility.matBadge" class="px-3 py-1 rounded-full text-xs font-black bg-red-600 text-white uppercase tracking-wider shadow-md">
            TATAMI OFICIAL DE COMPETICIÓN
          </span>
          <h3 data-i18n="facility.matTitle" class="text-xl sm:text-2xl font-black text-white font-display drop-shadow-md">
            Tatami Oficial de Competición · Zona de Fuerza & Calistenia
          </h3>
          <p data-i18n="facility.matDesc" class="text-xs text-zinc-300 max-w-lg">
            Recepción moderna, iluminación perimetral cálida, tatami continuo sin resquicios y climatización de alta potencia.
          </p>
        </div>

        <div class="bg-black/90 backdrop-blur-md px-5 py-3 rounded-2xl border border-white/15 text-right shrink-0">
          <span data-i18n="facility.matStatLabel" class="text-xs text-zinc-400 uppercase tracking-wider block">Tatami</span>
          <span data-i18n="facility.matStatValue" class="text-base font-black text-white">250 m² Amortiguado</span>
        </div>
      </div>
    </div>

    <!-- 4 Facility Feature Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map(f => (
        <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/10 hover:border-white/30 hover:-translate-y-1 transition-all duration-300">
          <div class="text-3xl mb-3">{f.icon}</div>
          <h4 data-i18n={f.titleKey} class="text-base font-bold text-white mb-2">{f.title}</h4>
          <p data-i18n={f.descKey} class="text-xs text-zinc-400 leading-relaxed">{f.desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>
