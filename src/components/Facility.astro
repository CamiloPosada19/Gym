---
// src/components/Facility.astro
const features = [
  {
    icon: "🛡️",
    title: "Tatami Planta Baja (70 m²)",
    desc: "70 m² de tatami oficial de competición con cámara de amortiguación anti-impactos para Judo Olímpico y BJJ.",
    titleKey: "facility.f1Title",
    descKey: "facility.f1Desc"
  },
  {
    icon: "🥋",
    title: "Tatami Planta Alta (100 m²)",
    desc: "100 m² de tatami independiente en la planta superior, ideal para tecnificación, randori y grupos de combate.",
    titleKey: "facility.f2Title",
    descKey: "facility.f2Desc"
  },
  {
    icon: "🚿",
    title: "Vestuarios Amplios & Nuevos",
    desc: "Duchas individuales, zonas de taquillas, limpieza y desinfección diaria bajo los más estrictos estándares higiénicos.",
    titleKey: "facility.f3Title",
    descKey: "facility.f3Desc"
  },
  {
    icon: "📍",
    title: "C/ de Perú, 14 (Planta G), 03008 Alicante",
    desc: "Nueva sede de Chidaoba en Alicante, con fácil acceso, zona de aparcamiento y excelentes conexiones de transporte para entrenar al máximo nivel.",
    titleKey: "facility.f4Title",
    descKey: "facility.f4Desc"
  }
];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="instalaciones" class="py-20 md:py-28 relative bg-zinc-50 dark:bg-[#050505] border-t border-zinc-200 dark:border-white/10 overflow-hidden transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div data-i18n="facility.badge" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-zinc-200/80 dark:bg-white/10 text-zinc-800 dark:text-white border border-zinc-300 dark:border-white/20">
        NUESTRO ESPACIO EN ALICANTE
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black font-display text-zinc-900 dark:text-white tracking-tight">
        <span data-i18n="facility.title">INSTALACIONES DISEÑADAS PARA EL</span> <span data-i18n="facility.titleHighlight" class="text-silver-gradient">ALTO NIVEL</span>
      </h2>
      <p data-i18n="facility.subtitle" class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300">
        Ubicado en C/ de Perú, 14 (Planta G), 03008 Alicante. Dos plantas con 170 m² de tatami homologado dedicados exclusivamente al judo y al brazilian jiu-jitsu.
      </p>
    </div>

    <!-- Big Video / Drone Tour Display -->
    <div class="relative rounded-3xl overflow-hidden border border-zinc-200 dark:border-white/15 shadow-md dark:shadow-card-elevated mb-12 group">
      <video
        src={`${base}/videos/recorrido_dron.mp4`}
        poster={`${base}/images/recorrido_dron_poster.jpg`}
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        class="w-full aspect-video sm:aspect-auto sm:h-[480px] object-cover object-center group-hover:scale-102 transition-transform duration-700"
      ></video>
      
      <!-- Subtle bottom gradient only behind text for legibility on desktop -->
      <div class="hidden sm:block absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/70 via-black/20 to-transparent pointer-events-none"></div>

      <div class="absolute bottom-3 right-3 sm:bottom-6 sm:left-6 sm:right-6 flex items-end justify-between pointer-events-none">
        <!-- Desktop only details (hidden on mobile) -->
        <div class="hidden sm:block space-y-1">
          <span data-i18n="facility.matBadge" class="px-3 py-1 rounded-full text-xs font-black bg-red-600 text-white uppercase tracking-wider shadow-md">
            TATAMI OFICIAL DE COMPETICIÓN
          </span>
          <h3 data-i18n="facility.matTitle" class="text-xl sm:text-2xl font-black text-white font-display drop-shadow-md">
            2 Tatamis Oficiales de Competición (100 m² + 70 m²)
          </h3>
          <p data-i18n="facility.matDesc" class="text-xs text-zinc-300 max-w-lg">
            Dos plantas con tatamis independientes (70 m² en planta baja y 100 m² en altillo), amortiguación anti-impactos y climatización de alta potencia.
          </p>
        </div>

        <!-- Tatamis Stat Badge (compact on mobile, full on desktop) -->
        <div class="bg-black/85 backdrop-blur-md px-2.5 py-1 sm:px-5 sm:py-3 rounded-xl sm:rounded-2xl border border-white/15 text-right shrink-0 shadow-lg">
          <span data-i18n="facility.matStatLabel" class="text-[8px] sm:text-xs text-zinc-400 uppercase tracking-wider block">Dos Tatamis</span>
          <span data-i18n="facility.matStatValue" class="text-[11px] sm:text-base font-black text-white">100 m² + 70 m²</span>
        </div>
      </div>
    </div>

    <!-- 4 Facility Feature Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map(f => (
        <div class="p-6 rounded-2xl bg-white dark:bg-white/[0.02] border border-zinc-200 dark:border-white/10 hover:border-zinc-300 dark:hover:border-white/30 hover:-translate-y-1 transition-all duration-300 shadow-sm dark:shadow-none flex flex-col justify-between">
          <div>
            <div class="text-3xl mb-3">{f.icon}</div>
            <h4 data-i18n={f.titleKey} class="text-base font-bold text-zinc-900 dark:text-white mb-2">{f.title}</h4>
            <p data-i18n={f.descKey} class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">{f.desc}</p>
          </div>
          {f.icon === "📍" && (
            <a
              href="https://www.google.com/maps/search/?api=1&query=Calle+de+Per%C3%BA+14+03008+Alicante"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-1.5 text-xs font-black text-red-600 dark:text-red-400 hover:underline"
              data-i18n="facility.mapCta"
            >
              <span>Abrir en Google Maps &rarr;</span>
            </a>
          )}
        </div>
      ))}
    </div>

    <!-- Interactive Google Maps Dojo Location Embed -->
    <div class="mt-12 rounded-3xl overflow-hidden border border-zinc-200 dark:border-white/10 shadow-xl bg-white dark:bg-[#09090C] relative group">
      <div class="relative w-full h-72 sm:h-96">
        <iframe
          title="Ubicación Club Deportivo Chidaoba en Google Maps"
          src="https://www.google.com/maps?q=Calle+de+Per%C3%BA+14+Alicante&output=embed"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full h-full filter contrast-[1.02]"
        ></iframe>
      </div>
      
      <!-- Footer bar with exact address & Google Maps navigation button -->
      <div class="p-5 sm:p-6 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-zinc-200 dark:border-white/10 bg-zinc-50 dark:bg-black/60">
        <div class="flex items-center gap-3.5">
          <div class="w-12 h-12 rounded-2xl bg-red-600/10 dark:bg-red-600/20 text-red-600 dark:text-red-400 border border-red-500/20 flex items-center justify-center text-2xl shrink-0">
            📍
          </div>
          <div>
            <h4 class="text-sm font-black text-zinc-900 dark:text-white uppercase tracking-wider font-display" data-i18n="facility.mapTitle">
              DOJO CHIDAOBA EN ALICANTE
            </h4>
            <p data-i18n="facility.mapAddress" class="text-xs text-zinc-600 dark:text-zinc-400">
              C/ de Perú, 14 (Planta G), 03008 Alicante
            </p>
          </div>
        </div>
        
        <a
          href="https://www.google.com/maps/search/?api=1&query=Calle+de+Per%C3%BA+14+03008+Alicante"
          target="_blank"
          rel="noopener noreferrer"
          data-i18n="facility.mapCta"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-red-600 hover:bg-red-500 text-white font-black text-xs uppercase tracking-wider shadow-lg shadow-red-600/25 hover:shadow-red-600/40 hover:-translate-y-0.5 transition-all duration-200 shrink-0"
        >
          <span>Abrir en Google Maps &rarr;</span>
        </a>
      </div>
    </div>

  </div>
</section>
