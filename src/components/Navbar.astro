---
// src/components/Navbar.astro
const navLinks = [
  { name: 'El Club', href: '#proyecto', i18nKey: 'nav.club' },
  { name: 'Entrenadores', href: '#entrenadores', i18nKey: 'nav.coaches' },
  { name: 'Disciplinas', href: '#disciplinas', i18nKey: 'nav.disciplines' },
  { name: 'Instalaciones', href: '#instalaciones', i18nKey: 'nav.facility' },
  { name: 'Horarios', href: '#horarios', i18nKey: 'nav.schedule' },
];

const whatsappNumber = "34600000000"; // Teléfono ficticio
const whatsappText = encodeURIComponent("¡Hola! Quiero consultar los horarios de Judo y BJJ en CHIDAOBA y solicitar información sobre cómo empezar.");
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappText}`;
---

<!-- Announcement Bar with Red & Black Contrast -->
<div class="bg-gradient-to-r from-zinc-950 via-zinc-900 to-zinc-950 text-white py-2.5 px-4 text-xs md:text-sm font-bold tracking-wide text-center relative z-50 shadow-lg border-b border-white/10">
  <div class="max-w-7xl mx-auto flex items-center justify-center gap-2 flex-wrap">
    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-black bg-red-600 text-white uppercase tracking-wider">
      ALICANTE
    </span>
    <span data-i18n-html="announcement.text"><strong class="text-white font-black">CHIDAOBA</strong>: Judo Olímpico y Brazilian Jiu-Jitsu · C/ de Perú, 14 (Alicante)</span>
    <a href="#horarios" data-i18n="announcement.cta" class="underline text-red-400 hover:text-red-300 transition-colors ml-1 font-black">
      Ver Horarios de Clases &rarr;
    </a>
  </div>
</div>

<!-- Main Sticky Navigation -->
<header class="sticky top-0 z-40 w-full backdrop-blur-xl bg-[#050505]/95 border-b border-white/10 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="#" class="flex items-center gap-2.5 sm:gap-3 group shrink-0">
        <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-gradient-to-br from-white via-zinc-300 to-zinc-600 p-0.5 shadow-lg shadow-white/5 group-hover:scale-105 group-hover:rotate-1 transition-all duration-300 shrink-0">
          <div class="w-full h-full bg-[#050505] rounded-[14px] flex items-center justify-center relative overflow-hidden">
            <span class="text-xl sm:text-2xl font-black text-white tracking-tighter">CH</span>
            <div class="absolute inset-0 bg-white/10 opacity-0 group-hover:opacity-100 transition-opacity"></div>
          </div>
        </div>
        <div class="flex flex-col">
          <span class="font-extrabold text-lg sm:text-2xl tracking-wider text-white uppercase font-display group-hover:text-red-500 transition-colors leading-tight">
            CHIDAOBA
          </span>
          <span class="text-[9px] sm:text-[10px] tracking-widest uppercase font-bold flex items-center gap-1 sm:gap-1.5">
            <span class="text-white">JUDO</span>
            <span class="w-1.5 h-1.5 rounded-full bg-red-600"></span>
            <span class="text-red-400 font-extrabold">BJJ</span>
            <span class="w-1 h-1 rounded-full bg-zinc-600"></span>
            <span class="text-zinc-400">ALICANTE</span>
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden lg:flex items-center gap-8 text-sm font-semibold tracking-wide text-zinc-300">
        {navLinks.map((link) => (
          <a
            href={link.href}
            data-i18n={link.i18nKey}
            class="hover:text-white transition-colors duration-200 relative py-1 group"
          >
            {link.name}
            <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-red-600 transition-all duration-300 group-hover:w-full"></span>
          </a>
        ))}
      </nav>

      <!-- Right Action Group: Single Language Toggle + Round WhatsApp + Mobile Menu -->
      <div class="flex items-center gap-2.5 sm:gap-3">
        
        <!-- SINGLE BILINGUAL TOGGLE PILL (ES / EN) -->
        <button
          id="lang-toggle-btn"
          type="button"
          class="inline-flex items-center p-1 rounded-full bg-white/10 hover:bg-white/15 border border-white/20 transition-all hover:scale-105 active:scale-95 cursor-pointer select-none shrink-0"
          aria-label="Cambiar idioma / Switch language"
          title="Cambiar idioma (Español / English)"
        >
          <span
            id="lang-pill-es"
            class="flex items-center gap-1 px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-full text-xs font-black transition-all duration-200 bg-red-600 text-white shadow-sm"
          >
            <span class="text-xs leading-none">🇪🇸</span>
            <span class="tracking-wider text-[11px] sm:text-xs">ES</span>
          </span>
          <span
            id="lang-pill-en"
            class="flex items-center gap-1 px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-full text-xs font-bold transition-all duration-200 text-zinc-400 hover:text-zinc-200"
          >
            <span class="text-xs leading-none">🇬🇧</span>
            <span class="tracking-wider text-[11px] sm:text-xs">EN</span>
          </span>
        </button>

        <!-- Mobile Menu Toggle Button (Visible on small screens) -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="lg:hidden p-2 rounded-xl text-white bg-white/10 hover:bg-white/20 border border-white/20 transition-all active:scale-95 focus:outline-none flex items-center justify-center shrink-0 cursor-pointer"
          aria-label="Abrir Menú"
          aria-expanded="false"
        >
          <!-- Hamburger Icon (Default) -->
          <svg id="icon-hamburger" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Close Icon (Hidden by default) -->
          <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-b border-white/10 bg-[#08080A]/98 backdrop-blur-2xl px-4 pt-2 pb-6 space-y-3">
    {navLinks.map((link) => (
      <a
        href={link.href}
        data-i18n={link.i18nKey}
        class="block px-3 py-2.5 rounded-lg text-base font-semibold text-zinc-300 hover:text-white hover:bg-white/5 transition-colors"
      >
        {link.name}
      </a>
    ))}
    <div class="pt-3 border-t border-white/10">
      <a
        id="mobile-wa-btn"
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-3 px-5 py-3 rounded-xl text-base font-bold bg-emerald-500 hover:bg-emerald-400 text-white shadow-lg shadow-emerald-500/25"
      >
        <span data-i18n="nav.mobileCta">Hablar con los Entrenadores</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconHam = document.getElementById('icon-hamburger');
    const iconClose = document.getElementById('icon-close');

    if (!btn || !menu) return;

    function openMenu() {
      menu.classList.remove('hidden');
      btn.setAttribute('aria-expanded', 'true');
      if (iconHam) iconHam.classList.add('hidden');
      if (iconClose) iconClose.classList.remove('hidden');
    }

    function closeMenu() {
      menu.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
      if (iconHam) iconHam.classList.remove('hidden');
      if (iconClose) iconClose.classList.add('hidden');
    }

    function toggleMenu(e) {
      if (e) e.stopPropagation();
      if (menu.classList.contains('hidden')) {
        openMenu();
      } else {
        closeMenu();
      }
    }

    btn.addEventListener('click', toggleMenu);

    const links = menu.querySelectorAll('a');
    links.forEach(l => l.addEventListener('click', closeMenu));

    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target) && !btn.contains(e.target)) {
        closeMenu();
      }
    });
  })();
</script>
