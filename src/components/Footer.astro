---
// src/components/Footer.astro
const whatsappNumber = "34610046042";
const whatsappText = encodeURIComponent("¡Hola! Os escribo desde la web oficial de CHIDAOBA para consultar horarios y clases.");
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappText}`;
---

<footer class="bg-[#F4F4F6] dark:bg-[#050505] border-t border-zinc-200 dark:border-white/10 text-zinc-600 dark:text-zinc-400 text-xs py-16 relative z-10 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-zinc-200 dark:border-white/10">
      
      <!-- Col 1: Brand & Ethos -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-zinc-800 to-zinc-600 dark:from-white dark:to-zinc-500 p-0.5 shadow-md">
            <div class="w-full h-full bg-[#0A0A0C] rounded-[14px] flex items-center justify-center">
              <span class="text-xl font-black text-white">CH</span>
            </div>
          </div>
          <div class="flex flex-col">
            <span class="text-xl font-black text-zinc-900 dark:text-white uppercase tracking-wider font-display">
              CHIDAOBA
            </span>
            <span data-i18n="footer.coachingTeam" class="text-[10px] tracking-widest text-red-600 dark:text-red-500 font-bold uppercase">
              JUDO & BJJ · EQUIPO TÉCNICO
            </span>
          </div>
        </div>

        <p data-i18n-html="footer.tagline" class="text-zinc-600 dark:text-zinc-400 max-w-md leading-relaxed text-xs sm:text-sm">
          El nuevo templo de las artes marciales en Alicante, liderado por <strong>Salvador Cases</strong> (Olímpico París 2024), <strong>Carlos Cases</strong> (Maestro Nacional) y <strong class="text-red-600 dark:text-red-400">Mirco Biscarini</strong> (Campeón de Europa BJJ).
        </p>

        <p data-i18n="footer.quote" class="text-zinc-500 dark:text-zinc-400 font-medium text-xs italic">
          "Jita Kyoei (Prosperidad mutua) · Seiryoku Zen'yo (Máxima eficacia con el mínimo esfuerzo)"
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div class="space-y-3">
        <h4 data-i18n="footer.navTitle" class="text-zinc-900 dark:text-white font-black uppercase tracking-wider text-xs font-display">
          Navegación
        </h4>
        <ul class="space-y-2 text-xs">
          <li><a href="#proyecto" data-i18n="nav.club" class="hover:text-red-600 dark:hover:text-red-400 transition-colors">El Club Chidaoba</a></li>
          <li><a href="#entrenadores" data-i18n="nav.coaches" class="hover:text-red-600 dark:hover:text-red-400 transition-colors">Los Entrenadores</a></li>
          <li><a href="#disciplinas" data-i18n="nav.disciplines" class="hover:text-red-600 dark:hover:text-red-400 transition-colors">Judo & BJJ Gi/No-Gi</a></li>
          <li><a href="#instalaciones" data-i18n="nav.facility" class="hover:text-red-600 dark:hover:text-red-400 transition-colors">Dojo & 2 Tatamis (100m² + 70m²)</a></li>
          <li><a href="#horarios" data-i18n="nav.schedule" class="hover:text-red-600 dark:hover:text-red-400 transition-colors">Horarios Oficiales</a></li>
        </ul>
      </div>

      <!-- Col 3: Real Contact & Socials -->
      <div class="space-y-3">
        <h4 data-i18n="footer.locTitle" class="text-zinc-900 dark:text-white font-black uppercase tracking-wider text-xs font-display">
          Ubicación & WhatsApp
        </h4>
        <ul class="space-y-2.5 text-xs">
          <li class="flex items-start gap-2">
            <span class="text-red-500 shrink-0">📍</span>
            <span data-i18n="footer.address">C/ de Perú, 14 (Planta G), 03008 Alicante</span>
          </li>
          <li class="flex items-center gap-2">
            <span>🥋</span>
            <span data-i18n="footer.hours">Horarios: Mañanas y Tardes (Lunes a Sábado)</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-red-500">💬</span>
            <a id="footer-wa-btn" href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="text-zinc-900 dark:text-zinc-200 hover:text-red-600 dark:hover:text-white hover:underline font-bold">
              WhatsApp: +34 610 04 60 42
            </a>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-zinc-500 dark:text-zinc-400">📸</span>
            <a href="https://instagram.com/salvacases" target="_blank" rel="noopener noreferrer" class="text-zinc-600 dark:text-zinc-400 hover:text-red-600 dark:hover:text-white transition-colors">
              Salva: @salvacases
            </a>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-red-500">📸</span>
            <a href="https://www.instagram.com/mibisjj/" target="_blank" rel="noopener noreferrer" class="text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-white transition-colors font-semibold">
              Mirco (BJJ): @mibisjj
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-zinc-500 dark:text-slate-500">
      <p data-i18n="footer.rights">© 2026 Club de Judo & BJJ Chidaoba · Salvador Cases, Carlos Cases, Mirco Biscarini & Luis Planelles. Todos los derechos reservados.</p>
      <div class="flex items-center gap-4">
        <span data-i18n="footer.legal">Aviso Legal</span>
        <span>·</span>
        <span data-i18n="footer.privacy">Política de Privacidad</span>
        <span>·</span>
        <span data-i18n="footer.keywords">Artes Marciales Alicante</span>
      </div>
    </div>
  </div>
</footer>
