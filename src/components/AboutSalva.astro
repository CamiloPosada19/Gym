---
// src/components/AboutSalva.astro
const palmaresSalva = [
  {
    title: "Juegos Olímpicos París 2024",
    titleKey: "about.salvaPalm1Title",
    result: "9º Clasificado Individual & Equipos",
    location: "París, Francia",
    highlight: true,
    tag: "Olímpico",
    tagKey: "about.salvaPalm1Tag"
  },
  {
    title: "Campeonato de Europa 2023",
    titleKey: "about.salvaPalm2Title",
    result: "Medalla de Plata (Subcampeón de Europa)",
    location: "Montpellier, Francia",
    highlight: true,
    tag: "Plata Europea",
    tagKey: "about.salvaPalm2Tag"
  },
  {
    title: "Grand Slam Circuit (IJF World Tour)",
    titleKey: "about.salvaPalm3Title",
    result: "3x Medallas de Bronce",
    location: "Abu Dabi, Tbilisi, Antalya",
    highlight: false,
    tag: "Grand Slam",
    tagKey: "about.salvaPalm3Tag"
  },
  {
    title: "Grand Prix Internacional",
    titleKey: "about.salvaPalm4Title",
    result: "2x Medallas de Plata",
    location: "Portugal (2022 y 2024)",
    highlight: false,
    tag: "Grand Prix",
    tagKey: "about.salvaPalm4Tag"
  }
];

const palmaresCarlos = [
  {
    title: "Campeonatos de España (Todas las categorías)",
    titleKey: "about.carlosPalm1Title",
    result: "Campeón de España Sub-15, Sub-17, Sub-21 y Absoluta",
    tag: "Campeón Pleno",
    tagKey: "about.carlosPalm1Tag"
  },
  {
    title: "Selección Nacional Española",
    titleKey: "about.carlosPalm2Title",
    result: "Componente del equipo nacional en torneos internacionales",
    tag: "Internacional",
    tagKey: "about.carlosPalm2Tag"
  },
  {
    title: "Dirección Deportiva Chidaoba",
    titleKey: "about.carlosPalm3Title",
    result: "Entrenador formador de campeones nacionales y olímpicos",
    tag: "Head Coach",
    tagKey: "about.carlosPalm3Tag"
  },
  {
    title: "Preparación Física & Fuerza",
    titleKey: "about.carlosPalm4Title",
    result: "Especialista en biomecánica y desarrollo marcial",
    tag: "Preparador",
    tagKey: "about.carlosPalm4Tag"
  }
];

const palmaresMirco = [
  {
    title: "Campeonato de Europa BJJ",
    titleKey: "about.mircoPalm1Title",
    result: "Campeón de Europa (European Champion 2022)",
    tag: "Oro Europeo",
    tagKey: "about.mircoPalm1Tag"
  },
  {
    title: "Spain BJJ Tour 2026",
    titleKey: "about.mircoPalm2Title",
    result: "Medalla de Plata (Black Belt Master Heavy)",
    tag: "Plata Nacional",
    tagKey: "about.mircoPalm2Tag"
  },
  {
    title: "Europe Cup BJJ 2025 & World Cup 2025",
    titleKey: "about.mircoPalm3Title",
    result: "Plata en Europe Cup & Bronce en World Cup",
    tag: "Podio Mundial",
    tagKey: "about.mircoPalm3Tag"
  },
  {
    title: "Spain Cup BJJ Gi 2021",
    titleKey: "about.mircoPalm4Title",
    result: "1º Clasificado y Medalla de Oro",
    tag: "Oro Copa España",
    tagKey: "about.mircoPalm4Tag"
  }
];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="entrenadores" class="py-20 md:py-28 relative bg-[#050505] border-y border-white/10 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div data-i18n="about.badge" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-white/10 text-white border border-white/20">
        STAFF TÉCNICO DE ÉLITE EN ALICANTE
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black font-display text-white tracking-tight">
        <span data-i18n="about.title">LOS ENTRENADORES</span> DE <span class="text-silver-gradient">CHIDAOBA</span>
      </h2>
      <p data-i18n="about.subtitle" class="text-base sm:text-lg text-zinc-300">
        Tres referentes del combate unen sus fuerzas para ofrecer la formación de Judo y Brazilian Jiu-Jitsu más avanzada del país: los hermanos <strong>Salvador Cases</strong> y <strong>Carlos Cases</strong> junto al maestro <strong class="text-red-400">Mirco Biscarini</strong>.
      </p>
    </div>

    <!-- 3 Coaches Profile Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-20">
      
      <!-- Coach 1: Salvador Cases (Judo Olímpico) -->
      <div class="glass-card p-6 sm:p-7 rounded-3xl border border-white/15 hover:border-white/40 hover:-translate-y-1 transition-all duration-300 relative group flex flex-col justify-between shadow-xl">
        <div class="space-y-5">
          
          <div class="flex flex-col items-center text-center gap-4 pb-5 border-b border-white/10">
            <div class="relative">
              <img
                src={`${base}/images/salva_profile_ijf.jpg`}
                alt="Foto real de Salvador Cases Judoka Olímpico"
                class="w-28 h-28 rounded-2xl object-cover border-2 border-white/40 shadow-xl group-hover:scale-105 transition-transform duration-300"
              />
              <span data-i18n="about.paris2024" class="absolute -bottom-2 -right-2 bg-white text-black text-[10px] font-black uppercase px-2 py-0.5 rounded-full shadow">
                PARÍS 2024
              </span>
            </div>
            
            <div>
              <span data-i18n="about.salvaRole" class="text-[10px] font-black uppercase tracking-widest text-white bg-white/10 px-2.5 py-0.5 rounded border border-white/20 inline-block mb-1">
                HEAD COACH · JUDO OLÍMPICO
              </span>
              <h3 class="text-xl sm:text-2xl font-black text-white font-display">
                Salvador Cases Roca
              </h3>
              <p data-i18n="about.salvaSubtitle" class="text-xs font-bold text-zinc-300">
                Subcampeón de Europa · Ne-Waza Specialist
              </p>
            </div>
          </div>

          <p data-i18n="about.salvaBio" class="text-xs text-zinc-300 leading-relaxed text-center sm:text-left">
            Judoka olímpico en París 2024 y medallista en el World Judo Tour (–73 kg). Su estilo ofensivo y su dominio del suelo lideran el método de combate y proyección en Chidaoba.
          </p>

          <!-- Palmarés summary -->
          <div class="space-y-2">
            <h4 data-i18n="about.salvaAchievements" class="text-[11px] font-black uppercase tracking-wider text-zinc-400">Logros Destacados:</h4>
            {palmaresSalva.slice(0, 4).map(item => (
              <div class="flex items-center justify-between p-2 rounded-xl bg-white/[0.03] border border-white/5 text-[11px]">
                <div class="truncate mr-2">
                  <span class="text-white font-bold mr-1">•</span>
                  <span data-i18n={item.titleKey} class="text-white font-medium">{item.title}</span>
                </div>
                <span data-i18n={item.tagKey} class="text-zinc-300 text-[10px] font-semibold shrink-0">{item.tag}</span>
              </div>
            ))}
          </div>

        </div>

        <div class="pt-5 mt-5 border-t border-white/10 text-center">
          <span data-i18n="about.salvaQuote" class="text-[11px] text-zinc-400 italic block">
            "El judo de competición llevado a la máxima exigencia y efectividad."
          </span>
        </div>
      </div>

      <!-- Coach 2: Carlos Cases (Director Técnico) -->
      <div class="glass-card p-6 sm:p-7 rounded-3xl border border-white/15 hover:border-white/40 hover:-translate-y-1 transition-all duration-300 relative group flex flex-col justify-between shadow-xl">
        <div class="space-y-5">
          
          <div class="flex flex-col items-center text-center gap-4 pb-5 border-b border-white/10">
            <div class="relative">
              <img
                src={`${base}/images/carlos_cases.jpg`}
                alt="Foto real de Carlos Cases entrenador y judoka"
                class="w-28 h-28 rounded-2xl object-cover border-2 border-white/30 shadow-xl group-hover:scale-105 transition-transform duration-300"
              />
              <span class="absolute -bottom-2 -right-2 bg-zinc-800 text-white border border-white/20 text-[10px] font-black uppercase px-2 py-0.5 rounded-full shadow">
                HEAD COACH
              </span>
            </div>
            
            <div>
              <span data-i18n="about.carlosRole" class="text-[10px] font-black uppercase tracking-widest text-zinc-300 bg-white/10 px-2.5 py-0.5 rounded border border-white/20 inline-block mb-1">
                DIRECTOR TÉCNICO · MAESTRO NACIONAL
              </span>
              <h3 class="text-xl sm:text-2xl font-black text-white font-display">
                Carlos Cases Roca
              </h3>
              <p data-i18n="about.carlosSubtitle" class="text-xs font-bold text-zinc-400">
                Maestro Nacional · Campeón de España
              </p>
            </div>
          </div>

          <p data-i18n="about.carlosBio" class="text-xs text-zinc-300 leading-relaxed text-center sm:text-left">
            Pilar pedagógico y hermano mayor de Salvador. Campeón de España en todas las categorías (Sub-15, Sub-17, Sub-21 y Absoluto) y formador de decenas de cinturones negros y campeones en Alicante.
          </p>

          <!-- Palmarés summary -->
          <div class="space-y-2">
            <h4 data-i18n="about.carlosSpecialties" class="text-[11px] font-black uppercase tracking-wider text-zinc-400">Especialidades:</h4>
            {palmaresCarlos.map(item => (
              <div class="flex items-center justify-between p-2 rounded-xl bg-white/[0.03] border border-white/5 text-[11px]">
                <div class="truncate mr-2">
                  <span class="text-zinc-400 font-bold mr-1">•</span>
                  <span data-i18n={item.titleKey} class="text-white font-medium">{item.title}</span>
                </div>
                <span data-i18n={item.tagKey} class="text-zinc-400 text-[10px] font-semibold shrink-0">{item.tag}</span>
              </div>
            ))}
          </div>

        </div>

        <div class="pt-5 mt-5 border-t border-white/10 text-center">
          <span data-i18n="about.carlosQuote" class="text-[11px] text-zinc-400 italic block">
            "Formar atletas y personas con respeto, carácter y perseverancia."
          </span>
        </div>
      </div>

      <!-- Coach 3: Mirco Biscarini (Head Coach BJJ) con acentos en ROJO -->
      <div class="glass-card-red p-6 sm:p-7 rounded-3xl border border-red-500/40 hover:border-red-500 hover:-translate-y-1 transition-all duration-300 relative group flex flex-col justify-between shadow-xl red-border-glow">
        <div class="space-y-5">
          
          <div class="flex flex-col items-center text-center gap-4 pb-5 border-b border-red-500/20">
            <div class="relative">
              <img
                src={`${base}/images/mirco_biscarini_real.jpg`}
                alt="Foto real de Mirco Biscarini Head Coach Brazilian Jiu-Jitsu"
                class="w-28 h-28 rounded-2xl object-cover border-2 border-red-500 shadow-xl group-hover:scale-105 transition-transform duration-300"
              />
              <span class="absolute -bottom-2 -right-2 bg-red-600 text-white text-[10px] font-black uppercase px-2 py-0.5 rounded-full shadow-md">
                FAIXA PRETA
              </span>
            </div>
            
            <div>
              <span data-i18n="about.mircoRole" class="text-[10px] font-black uppercase tracking-widest text-red-400 bg-red-600/15 px-2.5 py-0.5 rounded border border-red-500/30 inline-block mb-1">
                HEAD COACH BRAZILIAN JIU-JITSU
              </span>
              <h3 class="text-xl sm:text-2xl font-black text-white font-display">
                Mirco Biscarini
              </h3>
              <div class="flex items-center justify-center gap-2 mt-0.5">
                <span data-i18n="about.mircoSubtitle" class="text-xs font-bold text-red-300">Cinturón Negro BJJ · Team Kurama</span>
                <a
                  href="https://www.instagram.com/mibisjj/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-[11px] text-red-300 hover:text-white font-bold bg-red-600/20 hover:bg-red-600 px-2 py-0.5 rounded-full transition-colors border border-red-500/30"
                  title="Ver perfil de Instagram"
                >
                  <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                  <span>@mibisjj</span>
                </a>
              </div>
            </div>
          </div>

          <p data-i18n="about.mircoBio" class="text-xs text-zinc-300 leading-relaxed text-center sm:text-left">
            Campeón de Europa y competidor de élite en el circuito IBJJF y AJP Tour. Especialista en la enseñanza de BJJ con Gi y No-Gi Grappling, guardias de presión y sumisiones avanzadas.
          </p>

          <!-- Palmarés summary -->
          <div class="space-y-2">
            <h4 data-i18n="about.mircoTitles" class="text-[11px] font-black uppercase tracking-wider text-red-400">Palmarés & Títulos:</h4>
            {palmaresMirco.slice(0, 4).map(item => (
              <div class="flex items-center justify-between p-2 rounded-xl bg-red-950/20 border border-red-500/20 text-[11px]">
                <div class="truncate mr-2">
                  <span class="text-red-500 font-bold mr-1">•</span>
                  <span data-i18n={item.titleKey} class="text-white font-medium">{item.title}</span>
                </div>
                <span data-i18n={item.tagKey} class="text-red-300 text-[10px] font-semibold shrink-0">{item.tag}</span>
              </div>
            ))}
          </div>

        </div>

        <div class="pt-5 mt-5 border-t border-red-500/20 text-center">
          <span data-i18n="about.mircoQuote" class="text-[11px] text-zinc-400 italic block">
            "El Jiu-Jitsu es un ajedrez corporal donde la técnica vence a la fuerza."
          </span>
        </div>
      </div>

    </div>

    <!-- Real Photo Gallery of Chidaoba, Salva & Tatami -->
    <div class="space-y-6">
      <div class="text-center">
        <span data-i18n="about.galleryBadge" class="text-xs font-black uppercase tracking-wider text-red-500">GALERÍA REAL</span>
        <h3 data-i18n="about.galleryTitle" class="text-2xl font-black text-white font-display">
          Momentos Reales de Competición y Entrenamiento
        </h3>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Real photo 1: Salva podium -->
        <div class="relative rounded-2xl overflow-hidden border border-white/10 group shadow-lg">
          <img
            src={`${base}/images/salva_podium_absoluto.jpg`}
            alt="Salvador Cases en el podio de campeon de España"
            class="w-full h-64 object-cover object-center group-hover:scale-105 transition-transform duration-500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent flex items-end p-4">
            <div>
              <span data-i18n="about.badgePhoto1" class="text-[10px] font-black uppercase px-2 py-0.5 rounded bg-white text-black font-bold">Éxito Nacional</span>
              <p data-i18n="about.caption1" class="text-xs font-bold text-white mt-1">Salvador Cases en lo más alto del podio de España</p>
            </div>
          </div>
        </div>

        <!-- Real photo 2: Salva combat -->
        <div class="relative rounded-2xl overflow-hidden border border-white/10 group shadow-lg">
          <img
            src={`${base}/images/salva_competition_2.jpg`}
            alt="Salvador Cases combate de judo real"
            class="w-full h-64 object-cover object-top group-hover:scale-105 transition-transform duration-500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent flex items-end p-4">
            <div>
              <span data-i18n="about.badgePhoto2" class="text-[10px] font-black uppercase px-2 py-0.5 rounded bg-red-600 text-white font-bold">Grand Prix Final</span>
              <p data-i18n="about.caption2" class="text-xs font-bold text-white mt-1">Lucha por el oro en el circuito mundial</p>
            </div>
          </div>
        </div>

        <!-- Real photo 3: Mirco Biscarini real BJJ action -->
        <div class="relative rounded-2xl overflow-hidden border border-white/10 group shadow-lg">
          <img
            src={`${base}/images/mirco_bjj_action.jpg`}
            alt="Mirco Biscarini en acción real de competición de Brazilian Jiu-Jitsu"
            class="w-full h-64 object-cover object-center group-hover:scale-105 transition-transform duration-500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent flex items-end p-4">
            <div>
              <span data-i18n="about.badgePhoto3" class="text-[10px] font-black uppercase px-2 py-0.5 rounded bg-red-600 text-white font-bold">World Cup BJJ</span>
              <p data-i18n="about.caption3" class="text-xs font-bold text-white mt-1">Mirco Biscarini en acción oficial de competición</p>
            </div>
          </div>
        </div>

        <!-- Real photo 4: Chidaoba dojo training -->
        <div class="relative rounded-2xl overflow-hidden border border-white/10 group shadow-lg">
          <img
            src={`${base}/images/chidaoba_dojo_real.jpg`}
            alt="Club de judo Chidaoba tatami real en Alicante"
            class="w-full h-64 object-cover object-center group-hover:scale-105 transition-transform duration-500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent flex items-end p-4">
            <div>
              <span data-i18n="about.badgePhoto4" class="text-[10px] font-black uppercase px-2 py-0.5 rounded bg-zinc-800 text-white border border-white/20 font-bold">Tatami Chidaoba</span>
              <p data-i18n="about.caption4" class="text-xs font-bold text-white mt-1">Nuevo centro en C/ de Perú, 14 (Planta G)</p>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
