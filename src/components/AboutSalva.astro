    titleKey: "about.carlosPalm1Title",
    result: "Entrenador y coach olímpico en los Juegos de París 2024",
    tag: "París 2024",
    tagKey: "about.carlosPalm1Tag"
  },
  {
    title: "Medallista Nacional",
    titleKey: "about.carlosPalm2Title",
    result: "Medallas en Campeonatos de España Sub-15, Sub-17, Sub-21 y Absoluto",
    tag: "Todas las categorías",
    tagKey: "about.carlosPalm2Tag"
  },
  {
    title: "Medallista Internacional",
    titleKey: "about.carlosPalm3Title",
    result: "Medallista internacional con la Selección Española en todas las categorías",
    tag: "Todas las categorías",
    tagKey: "about.carlosPalm3Tag"
  },
  {
    title: "Dirección Deportiva",
    titleKey: "about.carlosPalm4Title",
    result: "Director técnico y formador de judokas y cinturones negros",
    tag: "Director Técnico",
    tagKey: "about.carlosPalm4Tag"
  }
];

const palmaresMirco = [
  {
    title: "Europe Cup BJJ 2025",
    titleKey: "about.mircoPalm1Title",
    result: "Subcampeón (Medalla de Plata Master 2 -92kg)",
    tag: "Plata Europea",
    tagKey: "about.mircoPalm1Tag"
  },
  {
    title: "World Cup BJJ 2025",
    titleKey: "about.mircoPalm2Title",
    result: "Medalla de Bronce (Master 1 Black Belt -92kg)",
    tag: "Podio Mundial",
    tagKey: "about.mircoPalm2Tag"
  },
  {
    title: "AJP Tour Alicante 2026",
    titleKey: "about.mircoPalm3Title",
    result: "Medalla de Bronce Internacional (Black Belt -85kg)",
    tag: "Podio AJP Tour",
    tagKey: "about.mircoPalm3Tag"
  },
  {
    title: "Head Coach Team Kurama",
    titleKey: "about.mircoPalm4Title",
    result: "Cinturón Negro (Faixa Preta) de Brazilian Jiu-Jitsu",
    tag: "Faixa Preta",
    tagKey: "about.mircoPalm4Tag"
  }
];

const palmaresLuis = [
  {
    title: "+15 Años de Experiencia en BJJ",
    titleKey: "about.luisPalm1Title",
    result: "Cinturón Negro (Faixa Preta) de Brazilian Jiu-Jitsu",
    tag: "Faixa Preta",
    tagKey: "about.luisPalm1Tag"
  },
  {
    title: "Especialista en BJJ Infantil & Juvenil",
    titleKey: "about.luisPalm2Title",
    result: "Profesor y formador pedagógico de niños y jóvenes",
    tag: "Kids Coach",
    tagKey: "about.luisPalm2Tag"
  },
  {
    title: "Desarrollo Psicomotriz & Disciplina",
    titleKey: "about.luisPalm3Title",
    result: "Metodología adaptada para inculcar valores y confianza",
    tag: "Pedagogía",
    tagKey: "about.luisPalm3Tag"
  },
  {
    title: "Defensa Personal & Fundamentos",
    titleKey: "about.luisPalm4Title",
    result: "Técnica sólida y control biomecánico para todas las edades",
    tag: "Grappling",
    tagKey: "about.luisPalm4Tag"
  }
];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="entrenadores" class="py-20 md:py-28 relative bg-white dark:bg-[#050505] border-y border-zinc-200 dark:border-white/10 overflow-hidden transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div data-i18n="about.badge" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-zinc-200/80 dark:bg-white/10 text-zinc-800 dark:text-white border border-zinc-300 dark:border-white/20">
        STAFF TÉCNICO DE ÉLITE EN ALICANTE
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black font-display text-zinc-900 dark:text-white tracking-tight">
        <span data-i18n="about.title">LOS ENTRENADORES</span> DE <span class="text-silver-gradient">CHIDAOBA</span>
      </h2>
      <p data-i18n="about.subtitle" class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300">
        Cuatro referentes del combate unen sus fuerzas para ofrecer la formación de Judo y Brazilian Jiu-Jitsu más avanzada del país: los hermanos <strong>Salvador Cases</strong> y <strong>Carlos Cases</strong> junto a los maestros de BJJ <strong class="text-red-600 dark:text-red-400">Mirco Biscarini</strong> y <strong>Luis Planelles</strong>.
      </p>
    </div>

    <!-- 4 Coaches Profile Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-20">
      
      <!-- Coach 1: Salvador Cases (Judo Olímpico) -->
      <div class="glass-card p-6 sm:p-7 rounded-3xl border border-zinc-200 dark:border-white/15 hover:border-zinc-300 dark:hover:border-white/40 hover:-translate-y-1 transition-all duration-300 relative group flex flex-col justify-between shadow-lg dark:shadow-xl">
        <div class="space-y-5">
          
          <div class="flex flex-col items-center text-center gap-4 pb-5 border-b border-zinc-200 dark:border-white/10">
            <div class="relative">
              <img
                src={`${base}/images/salva_profile_ijf.jpg`}
                alt="Foto real de Salvador Cases Judoka Olímpico"
                class="w-28 h-28 rounded-2xl object-cover border-2 border-white/60 dark:border-white/40 shadow-xl group-hover:scale-105 transition-transform duration-300"
              />
              <span data-i18n="about.paris2024" class="absolute -bottom-2 -right-2 bg-zinc-900 dark:bg-white text-white dark:text-black text-[10px] font-black uppercase px-2 py-0.5 rounded-full shadow">
                PARÍS 2024
              </span>
            </div>
            
            <div>
              <span data-i18n="about.salvaRole" class="text-[10px] font-black uppercase tracking-widest text-zinc-700 dark:text-white bg-zinc-100 dark:bg-white/10 px-2.5 py-0.5 rounded border border-zinc-200 dark:border-white/20 inline-block mb-1">
                HEAD COACH · JUDO OLÍMPICO
              </span>
              <h3 class="text-xl sm:text-2xl font-black text-zinc-900 dark:text-white font-display">
                Salvador Cases Roca
              </h3>
              <p data-i18n="about.salvaSubtitle" class="text-xs font-bold text-zinc-600 dark:text-zinc-300">
                Subcampeón de Europa · Ne-Waza Specialist
              </p>
            </div>
          </div>

          <p data-i18n="about.salvaBio" class="text-xs text-zinc-600 dark:text-zinc-300 leading-relaxed text-center sm:text-left">
            Judoka olímpico en París 2024 y medallista en el World Judo Tour (–73 kg). Su estilo ofensivo y su dominio del suelo lideran el método de combate y proyección en Chidaoba.
          </p>

          <!-- Palmarés summary -->
          <div class="space-y-2">
            <h4 data-i18n="about.salvaAchievements" class="text-[11px] font-black uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Logros Destacados:</h4>
            {palmaresSalva.slice(0, 4).map(item => (
              <div class="flex items-center justify-between p-2 rounded-xl bg-zinc-50 dark:bg-white/[0.03] border border-zinc-200 dark:border-white/5 text-[11px]">
                <div class="truncate mr-2">
                  <span class="text-red-600 dark:text-white font-bold mr-1">•</span>
                  <span data-i18n={item.titleKey} class="text-zinc-800 dark:text-white font-medium">{item.title}</span>
                </div>
                <span data-i18n={item.tagKey} class="text-zinc-600 dark:text-zinc-300 text-[10px] font-semibold shrink-0">{item.tag}</span>
              </div>
            ))}
          </div>

        </div>

        <div class="pt-5 mt-5 border-t border-zinc-200 dark:border-white/10 text-center">
          <span data-i18n="about.salvaQuote" class="text-[11px] text-zinc-500 dark:text-zinc-400 italic block">
            "El judo de competición llevado a la máxima exigencia y efectividad."
          </span>
        </div>
      </div>

      <!-- Coach 2: Carlos Cases (Director Técnico) -->
      <div class="glass-card p-6 sm:p-7 rounded-3xl border border-zinc-200 dark:border-white/15 hover:border-zinc-300 dark:hover:border-white/40 hover:-translate-y-1 transition-all duration-300 relative group flex flex-col justify-between shadow-lg dark:shadow-xl">
        <div class="space-y-5">
          
          <div class="flex flex-col items-center text-center gap-4 pb-5 border-b border-zinc-200 dark:border-white/10">
            <div class="relative">
              <img
                src={`${base}/images/carlos_cases.jpg`}
                alt="Foto real de Carlos Cases entrenador y judoka"
                class="w-28 h-28 rounded-2xl object-cover border-2 border-white/60 dark:border-white/30 shadow-xl group-hover:scale-105 transition-transform duration-300"
              />
              <span class="absolute -bottom-2 -right-2 bg-zinc-800 text-white border border-white/20 text-[10px] font-black uppercase px-2 py-0.5 rounded-full shadow">
                HEAD COACH
              </span>
            </div>
            
            <div>
              <span data-i18n="about.carlosRole" class="text-[10px] font-black uppercase tracking-widest text-zinc-700 dark:text-zinc-300 bg-zinc-100 dark:bg-white/10 px-2.5 py-0.5 rounded border border-zinc-200 dark:border-white/20 inline-block mb-1">
                DIRECTOR TÉCNICO · ENTRENADOR OLÍMPICO PARÍS 2024
              </span>
              <h3 class="text-xl sm:text-2xl font-black text-zinc-900 dark:text-white font-display">
                Carlos Cases Roca
              </h3>
              <p data-i18n="about.carlosSubtitle" class="text-xs font-bold text-zinc-500 dark:text-zinc-400">
                Entrenador Olímpico París 2024 · Medallista Nacional
              </p>
            </div>
          </div>

          <p data-i18n="about.carlosBio" class="text-xs text-zinc-600 dark:text-zinc-300 leading-relaxed text-center sm:text-left">
            Pilar pedagógico y hermano mayor de Salvador. Entrenador olímpico en los Juegos de París 2024 y medallista nacional en todas las categorías (Sub-15, Sub-17, Sub-21 y Absoluto), formador de decenas de cinturones negros y campeones de España.
          </p>

          <!-- Palmarés summary -->
          <div class="space-y-2">
            <h4 data-i18n="about.carlosSpecialties" class="text-[11px] font-black uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Especialidades:</h4>
            {palmaresCarlos.map(item => (
              <div class="flex items-center justify-between px-2.5 py-1.5 rounded-xl bg-zinc-50 dark:bg-white/[0.03] border border-zinc-200 dark:border-white/5 text-[11px] gap-1">
                <div class="flex items-center gap-1 min-w-0">
                  <span class="text-zinc-400 font-bold shrink-0">•</span>
                  <span data-i18n={item.titleKey} class="text-zinc-800 dark:text-white font-medium text-[10px] xl:text-[10.5px] leading-tight">{item.title}</span>
                </div>
                <span data-i18n={item.tagKey} class="text-zinc-500 dark:text-zinc-400 text-[8.5px] xl:text-[9.5px] font-semibold shrink-0 tracking-tight">{item.tag}</span>
              </div>
            ))}
          </div>

        </div>

        <div class="pt-5 mt-5 border-t border-zinc-200 dark:border-white/10 text-center">
          <span data-i18n="about.carlosQuote" class="text-[11px] text-zinc-500 dark:text-zinc-400 italic block">
            "Formar atletas y personas con respeto, carácter y perseverancia."
          </span>
        </div>
      </div>

      <!-- Coach 3: Mirco Biscarini (Head Coach BJJ) con acentos en ROJO -->
      <div class="glass-card-red p-6 sm:p-7 rounded-3xl border border-red-500/40 hover:border-red-500 hover:-translate-y-1 transition-all duration-300 relative group flex flex-col justify-between shadow-lg dark:shadow-xl red-border-glow">
        <div class="space-y-5">
          
          <div class="flex flex-col items-center text-center gap-4 pb-5 border-b border-red-500/20">
            <div class="relative">
              <img
                src={`${base}/images/mirco_biscarini_real.jpg`}
                alt="Foto real de Mirco Biscarini Head Coach Brazilian Jiu-Jitsu"
                class="w-28 h-28 rounded-2xl object-cover border-2 border-red-500 shadow-xl group-hover:scale-105 transition-transform duration-300"
              />
              <span class="absolute -bottom-2 -right-2 bg-red-600 text-white text-[10px] font-black uppercase px-2 py-0.5 rounded-full shadow-md">
                FAIXA PRETA
              </span>
            </div>
            
            <div>
              <span data-i18n="about.mircoRole" class="text-[10px] font-black uppercase tracking-widest text-red-400 bg-red-600/15 px-2.5 py-0.5 rounded border border-red-500/30 inline-block mb-1">
                HEAD COACH BRAZILIAN JIU-JITSU
              </span>
              <h3 class="text-xl sm:text-2xl font-black text-zinc-900 dark:text-white font-display">
                Mirco Biscarini
              </h3>
              <div class="flex items-center justify-center gap-2 mt-0.5">
                <span data-i18n="about.mircoSubtitle" class="text-xs font-bold text-red-600 dark:text-red-300">Cinturón Negro BJJ · Team Kurama</span>
                <a
                  href="https://www.instagram.com/mibisjj/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-[11px] text-red-600 dark:text-red-300 hover:text-red-700 dark:hover:text-white font-bold bg-red-600/10 dark:bg-red-600/20 hover:bg-red-600/20 px-2 py-0.5 rounded-full transition-colors border border-red-500/30"
                  title="Ver perfil de Instagram"
                >
                  <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                  <span>@mibisjj</span>
                </a>
              </div>
            </div>
          </div>

          <p data-i18n="about.mircoBio" class="text-xs text-zinc-600 dark:text-zinc-300 leading-relaxed text-center sm:text-left">
            Cinturón Negro (Faixa Preta) y fundador de Team Kurama en Alicante. Competidor activo y medallista en los circuitos internacionales AJP Tour y Europe Cup BJJ, especializado en BJJ con Gi, No-Gi Grappling y combate de suelo de alta exigencia.
          </p>

          <!-- Palmarés summary -->
          <div class="space-y-2">
            <h4 data-i18n="about.mircoTitles" class="text-[11px] font-black uppercase tracking-wider text-red-600 dark:text-red-400">Palmarés & Títulos:</h4>
            {palmaresMirco.slice(0, 4).map(item => (
              <div class="flex items-center justify-between p-2 rounded-xl bg-red-100/50 dark:bg-red-950/20 border border-red-500/20 text-[11px]">
                <div class="truncate mr-2">
                  <span class="text-red-500 font-bold mr-1">•</span>
                  <span data-i18n={item.titleKey} class="text-zinc-800 dark:text-white font-medium">{item.title}</span>
                </div>
                <span data-i18n={item.tagKey} class="text-red-600 dark:text-red-300 text-[10px] font-semibold shrink-0">{item.tag}</span>
              </div>
            ))}
          </div>

        </div>

        <div class="pt-5 mt-5 border-t border-red-500/20 text-center">
          <span data-i18n="about.mircoQuote" class="text-[11px] text-zinc-500 dark:text-zinc-400 italic block">
            "El Jiu-Jitsu es un ajedrez corporal donde la técnica vence a la fuerza."
          </span>
        </div>
      </div>

      <!-- Coach 4: Luis Planelles Mira (Profesor BJJ & Especialista Kids) con acentos en ROJO -->
      <div class="glass-card-red p-6 sm:p-7 rounded-3xl border border-red-500/40 hover:border-red-500 hover:-translate-y-1 transition-all duration-300 relative group flex flex-col justify-between shadow-lg dark:shadow-xl red-border-glow">
        <div class="space-y-5">
          
          <div class="flex flex-col items-center text-center gap-4 pb-5 border-b border-red-500/20">
            <div class="relative">
              <img
                src={`${base}/images/luis_bjj.jpg`}
                alt="Foto real de Luis Planelles Mira profesor de Brazilian Jiu-Jitsu"
                class="w-28 h-28 rounded-2xl object-cover object-top border-2 border-red-500 shadow-xl group-hover:scale-105 transition-transform duration-300"
              />
              <span class="absolute -bottom-2 -right-2 bg-red-600 text-white text-[10px] font-black uppercase px-2 py-0.5 rounded-full shadow-md">
                +15 AÑOS EXP.
              </span>
            </div>
            
            <div>
              <span data-i18n="about.luisRole" class="text-[10px] font-black uppercase tracking-widest text-red-400 bg-red-600/15 px-2.5 py-0.5 rounded border border-red-500/30 inline-block mb-1">
                PROFESOR BJJ · ESPECIALISTA KIDS
              </span>
              <h3 class="text-xl sm:text-2xl font-black text-zinc-900 dark:text-white font-display">
                Luis Planelles Mira
              </h3>
              <p data-i18n="about.luisSubtitle" class="text-xs font-bold text-red-600 dark:text-red-300">
                Cinturón Negro BJJ · +15 Años de Experiencia
              </p>
            </div>
          </div>

          <p data-i18n="about.luisBio" class="text-xs text-zinc-600 dark:text-zinc-300 leading-relaxed text-center sm:text-left">
            Con más de 15 años sobre el tatami y cinturón negro de Brazilian Jiu-Jitsu, Luis lidera el programa pedagógico de BJJ Infantil (Kids) y adultos. Especialista en motricidad, disciplina, respeto y valores para las nuevas generaciones de deportistas.
          </p>

          <!-- Palmarés / Especialidades summary -->
          <div class="space-y-2">
            <h4 data-i18n="about.luisSpecialties" class="text-[11px] font-black uppercase tracking-wider text-red-600 dark:text-red-400">Especialidades:</h4>
            {palmaresLuis.map(item => (
              <div class="flex items-center justify-between p-2 rounded-xl bg-red-100/50 dark:bg-red-950/20 border border-red-500/20 text-[11px]">
                <div class="truncate mr-2">
                  <span class="text-red-500 font-bold mr-1">•</span>
                  <span data-i18n={item.titleKey} class="text-zinc-800 dark:text-white font-medium">{item.title}</span>
                </div>
                <span data-i18n={item.tagKey} class="text-red-600 dark:text-red-300 text-[10px] font-semibold shrink-0">{item.tag}</span>
              </div>
            ))}
          </div>

        </div>

        <div class="pt-5 mt-5 border-t border-red-500/20 text-center">
          <span data-i18n="about.luisQuote" class="text-[11px] text-zinc-500 dark:text-zinc-400 italic block">
            "La disciplina, el respeto y la diversión en el tatami forjan la confianza para toda la vida."
          </span>
        </div>
      </div>

    </div>

    <!-- Real Photo Gallery of Chidaoba, Salva & Tatami -->
    <div class="space-y-6">
      <div class="text-center">
        <span data-i18n="about.galleryBadge" class="text-xs font-black uppercase tracking-wider text-red-500">GALERÍA REAL</span>
        <h3 data-i18n="about.galleryTitle" class="text-2xl font-black text-zinc-900 dark:text-white font-display">
          Momentos Reales de Competición y Entrenamiento
        </h3>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Real photo 1: Carlos Cases competition throw -->
        <div class="relative rounded-2xl overflow-hidden border border-zinc-200 dark:border-white/10 group shadow-md dark:shadow-lg">
          <img
            src={`${base}/images/carlos_competition_throw.jpg`}
            alt="Carlos Cases proyectando en combate oficial de Judo"
            class="w-full h-64 object-cover object-center group-hover:scale-105 transition-transform duration-500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent flex items-end p-4">
            <div>
              <span data-i18n="about.badgePhoto1" class="text-[10px] font-black uppercase px-2 py-0.5 rounded bg-white text-black font-bold">Judo Competición</span>
              <p data-i18n="about.caption1" class="text-xs font-bold text-white mt-1">Carlos Cases en combate oficial de Judo</p>
            </div>
          </div>
