---
// src/components/AboutSalva.astro
const palmaresSalva = [
  {
    title: "Juegos Olímpicos París 2024",
    titleKey: "about.salvaPalm1Title",
    result: "9º Clasificado Individual & Equipos",
    location: "París, Francia",
    highlight: true,
    tag: "Olímpico",
    tagKey: "about.salvaPalm1Tag"
  },
  {
    title: "Campeonato de Europa 2023",
    titleKey: "about.salvaPalm2Title",
    result: "Medalla de Plata (Subcampeón de Europa)",
    location: "Montpellier, Francia",
    highlight: true,
    tag: "Plata Europea",
    tagKey: "about.salvaPalm2Tag"
  },
  {
    title: "Grand Slam Circuit (IJF World Tour)",
    titleKey: "about.salvaPalm3Title",
    result: "3x Medallas de Bronce",
    location: "Abu Dabi, Tbilisi, Antalya",
    highlight: false,
    tag: "Grand Slam",
    tagKey: "about.salvaPalm3Tag"
  },
  {
